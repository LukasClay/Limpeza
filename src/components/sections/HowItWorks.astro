---
import { processItems } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="how-it-works" class="bg-white py-16 md:py-24" aria-labelledby="how-it-works-title">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">How it works</p>
      <h2 id="how-it-works-title" class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        A clear path from request to a cleaner space.
      </h2>
      <p class="mt-4 text-lg text-muted">
        The process is simple: share the details, understand the estimate, schedule the visit, and enjoy the finished space.
      </p>
    </div>

    <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {
        processItems.map((item, index) => (
          <li class="reveal relative flex flex-col gap-4 rounded-lg border border-slate-200 bg-mist p-5 sm:p-6">
            <div class="flex items-center gap-3">
              <span class="flex size-10 items-center justify-center rounded-full bg-green text-base font-extrabold text-white">
                {index + 1}
              </span>
              <span class="flex size-10 items-center justify-center rounded-md bg-white text-green shadow-sm">
                <Icon name={item.icon} />
              </span>
            </div>
            <div>
              <h3 class="text-lg font-bold text-navy">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
