---
import { Picture } from "astro:assets";
import heroImg from "../../assets/hero-cleaning.png";
import { brand } from "../../data/brand";
import { aboutPoints } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="about" class="bg-white py-16 md:py-24">
  <div class="section-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
    <div class="reveal relative">
      <Picture
        src={heroImg}
        alt="Clean home interior representing professional residential cleaning"
        class="aspect-[4/3] w-full rounded-lg object-cover shadow-[0_24px_70px_rgba(15,31,61,0.16)]"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 500px, 100vw"
        loading="lazy"
        formats={["avif", "webp"]}
        quality={75}
      />
      <div class="mt-4 rounded-lg bg-white p-5 shadow-xl ring-1 ring-slate-200 sm:absolute sm:bottom-4 sm:left-4 sm:right-auto sm:mt-0 sm:w-80 sm:bg-white/95">
        <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-green">Built around clarity</p>
        <p class="mt-2 text-xl font-bold text-navy">{brand.tagline}</p>
      </div>
    </div>

    <div class="reveal">
      <p class="eyebrow">About ALL PRO</p>
      <h2 class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        Cleaning service with a clear process and careful execution.
      </h2>
      <p class="mt-5 text-base leading-7 text-muted sm:text-lg sm:leading-8">
        ALL PRO Cleaning Services helps homeowners and businesses keep their spaces cleaner,
        more organized, and easier to use. The service is built around clear estimates,
        practical scheduling, and attention to the details that affect how a space feels after
        the cleaning is done.
      </p>
      <div class="mt-8 grid gap-3 sm:grid-cols-2 md:grid-cols-4">
        {
          aboutPoints.map((point) => (
            <div class="rounded-lg border border-slate-200 bg-mist p-4">
              <div class="flex size-10 items-center justify-center rounded-md bg-white text-green shadow-sm">
                <Icon name={point.icon} />
              </div>
              <p class="mt-4 font-extrabold text-navy">{point.title}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
