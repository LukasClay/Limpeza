---
import { services } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="services" class="bg-mist py-16 md:py-24">
  <div class="section-shell">
    <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="eyebrow">Our Services</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
          Residential & Commercial Cleaning Services
        </h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-muted sm:text-lg sm:leading-8 md:justify-self-end">
        Cleaning for homes, offices, moves, and post-construction spaces handled with one clear
        process.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="service-card reveal rounded-lg border border-slate-200 bg-white p-5 shadow-[0_10px_30px_rgba(15,31,61,0.05)] sm:p-7">
            <div class="relative z-10">
              <div class="flex items-start justify-between gap-4">
                <div class="service-card__icon flex size-12 items-center justify-center rounded-md bg-navy text-white">
                  <Icon name={service.icon} class="size-6" strokeWidth={1.8} />
                </div>
                <span class="service-card__badge rounded-full bg-mist px-3 py-1 text-xs font-extrabold uppercase tracking-[0.12em] text-green">
                  ALL PRO Standard
                </span>
              </div>
              <h3 class="mt-7 text-2xl font-bold text-navy">{service.title}</h3>
              <p class="mt-3 leading-7 text-muted">{service.text}</p>
              <p class="mt-5 text-sm text-muted">
                <span class="font-extrabold text-navy">Ideal for:</span> {service.ideal}
              </p>
              <a class="service-card__cta mt-6 inline-flex items-center gap-2 text-sm font-extrabold text-green transition hover:text-navy" href="#contact">
                {service.cta}
                <span aria-hidden="true" class="service-card__arrow">&rarr;</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
