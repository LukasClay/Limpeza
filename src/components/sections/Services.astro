---
import { services } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="services" class="bg-mist py-16 md:py-24">
  <div class="section-shell">
    <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:items-end">
      <div>
        <p class="eyebrow">Our Services</p>
        <h2 class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
          Residential & Commercial Cleaning Services
        </h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-muted sm:text-lg sm:leading-8 md:justify-self-end">
        Professional cleaning for every kind of space, with a consistent standard from first
        contact to final walkthrough.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <article class="reveal hover-lift rounded-lg border border-slate-200 bg-white p-5 shadow-[0_10px_30px_rgba(15,31,61,0.05)] transition duration-300 hover:-translate-y-1 hover:border-[#cfdccf] hover:shadow-[0_18px_42px_rgba(15,31,61,0.09)] sm:p-7">
            <div class="flex items-start justify-between gap-4">
              <div class="flex size-12 items-center justify-center rounded-md bg-navy text-white">
                <Icon name={service.icon} class="size-6" strokeWidth={1.8} />
              </div>
              <span class="rounded-full bg-mist px-3 py-1 text-xs font-extrabold uppercase tracking-[0.12em] text-green">
                ALL PRO Standard
              </span>
            </div>
            <h3 class="mt-7 text-2xl font-bold text-navy">{service.title}</h3>
            <p class="mt-3 leading-7 text-muted">{service.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
