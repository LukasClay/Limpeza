---
import { trustBar } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section aria-label="Trust badges" class="border-y border-slate-200 bg-white">
  <div class="section-shell grid gap-3 py-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      trustBar.map((item) => (
        <div class="flex items-start gap-3 rounded-lg border border-slate-100 bg-white px-3 py-3 shadow-[0_8px_20px_rgba(15,31,61,0.03)]">
          <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-mist text-green">
            <Icon name={item.icon} />
          </span>
          <span>
            <strong class="block text-sm text-navy">{item.title}</strong>
            <span class="text-sm text-slate-500">{item.text}</span>
          </span>
        </div>
      ))
    }
  </div>
</section>
