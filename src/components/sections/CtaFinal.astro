---
import { brand } from "../../data/brand";
import { whatsappDefaultUrl } from "../../lib/whatsapp";
import Icon from "../ui/Icon.astro";
---

<section aria-labelledby="cta-final-title" class="bg-mist py-16 md:py-20">
  <div class="section-shell">
    <div class="reveal mx-auto max-w-3xl text-center">
      <p class="eyebrow">Ready when you are</p>
      <h2 id="cta-final-title" class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        Ready for a cleaner space? Request your free estimate.
      </h2>
      <p class="mt-4 text-base leading-7 text-muted sm:text-lg">
        Tell us what type of cleaning you need and where you are located. We will help you understand the next step clearly.
      </p>
    </div>

    <div class="mt-10 grid gap-3 sm:grid-cols-3">
      <a
        href={whatsappDefaultUrl}
        target="_blank"
        rel="noopener"
        class="hover-lift flex items-center justify-center gap-3 rounded-lg bg-whatsapp px-5 py-5 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(37,211,102,0.28)] transition hover:-translate-y-0.5 hover:bg-whatsapp-dark"
      >
        <Icon name="whatsapp" class="size-5" strokeWidth={2} />
        Chat on WhatsApp
      </a>
      <a
        href={brand.phoneHref}
        class="hover-lift flex items-center justify-center gap-3 rounded-lg bg-navy px-5 py-5 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(11,31,51,0.28)] transition hover:-translate-y-0.5"
      >
        <Icon name="phone" class="size-5" strokeWidth={2} />
        Call {brand.phoneDisplay}
      </a>
      <a
        href="#contact"
        class="hover-lift flex items-center justify-center gap-3 rounded-lg bg-green px-5 py-5 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(46,125,50,0.28)] transition hover:-translate-y-0.5 hover:bg-green-dark"
      >
        <Icon name="estimate" class="size-5" strokeWidth={2} />
        {brand.primaryCta}
      </a>
    </div>

    <p class="mt-6 text-center text-sm text-muted">
      Residential cleaning · Commercial cleaning · Serving Massachusetts
    </p>
  </div>
</section>
