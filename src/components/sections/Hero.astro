---
import { Picture } from "astro:assets";
import heroImg from "../../assets/hero-cleaning.png";
import { brand } from "../../data/brand";
import { services } from "../../data/site";
import { whatsappDefaultUrl } from "../../lib/whatsapp";
import Icon from "../ui/Icon.astro";
---

<section class="relative overflow-hidden bg-navy text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(46,184,114,0.16),transparent_30%),linear-gradient(135deg,#0B1F33_0%,#11294A_58%,#07172A_100%)]"></div>
  <div class="section-shell relative grid gap-10 py-10 sm:py-12 md:grid-cols-[0.92fr_1.08fr] md:py-16 lg:min-h-[calc(100svh-72px)] lg:py-20">
    <div class="reveal max-w-2xl text-white">
      <p class="inline-flex rounded-md border border-white/15 bg-white/10 px-3 py-2 text-xs font-extrabold uppercase tracking-[0.16em] text-[#d8ead3]">
        Residential & Commercial Cleaning
      </p>
      <h1 class="mt-5 text-[clamp(2.35rem,9.2vw,4.4rem)] font-bold leading-[1.04] md:mt-6 md:text-6xl lg:text-7xl">
        Professional Cleaning Services for Homes and Businesses
      </h1>
      <p class="mt-5 max-w-xl text-base leading-7 text-slate-100 sm:text-lg md:mt-6 md:text-xl md:leading-8">
        Reliable residential, commercial, move-in, move-out, and post-construction cleaning across Massachusetts.
      </p>
      <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base sm:leading-7">
        Clear estimates, organized communication, and detail-oriented service from the first request to the final walkthrough.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a
          href={whatsappDefaultUrl}
          target="_blank"
          rel="noopener"
          class="hover-lift inline-flex min-h-[52px] items-center justify-center gap-2 rounded-md bg-whatsapp px-5 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(37,211,102,0.32)] transition hover:-translate-y-0.5 hover:bg-whatsapp-dark sm:px-7"
        >
          <Icon name="whatsapp" class="size-5" strokeWidth={2} />
          Chat on WhatsApp
        </a>
        <a
          href="#contact"
          class="hover-lift inline-flex min-h-[52px] items-center justify-center rounded-md bg-green px-5 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(46,125,50,0.28)] transition hover:-translate-y-0.5 hover:bg-green-dark sm:px-7"
        >
          Get Free Estimate
        </a>
        <a
          href={brand.phoneHref}
          class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-white/25 bg-white/10 px-5 text-base font-extrabold text-white transition hover:bg-white hover:text-navy sm:px-7"
        >
          Call {brand.phoneDisplay}
        </a>
      </div>

      <div class="mt-8 grid gap-3 text-sm font-bold text-slate-100 sm:grid-cols-3">
        {["Fully Insured", "Free Estimates", "Serving Massachusetts"].map((item) => (
          <div class="flex items-center gap-2 rounded-md border border-white/[0.12] bg-white/[0.08] px-3 py-3">
            <span class="flex size-6 items-center justify-center rounded-full bg-green-accent/20 text-[#d8ead3]">
              <Icon name="shield" class="size-4" strokeWidth={2} />
            </span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="reveal relative mx-auto w-full max-w-2xl md:max-w-none">
      <div class="relative overflow-hidden rounded-lg bg-navy-soft shadow-[0_34px_90px_rgba(2,8,23,0.32)] ring-1 ring-white/10">
        <Picture
          src={heroImg}
          alt="Bright clean interior after professional cleaning service"
          class="aspect-[4/3] w-full object-cover opacity-95"
          widths={[640, 960, 1280, 1536]}
          sizes="(min-width: 1024px) 600px, (min-width: 768px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
          formats={["avif", "webp"]}
          quality={78}
        />
        <div class="absolute inset-0 z-10 bg-gradient-to-t from-navy-soft/[0.72] via-transparent to-transparent"></div>
        <div class="relative z-20 grid gap-3 p-3 sm:absolute sm:bottom-4 sm:left-4 sm:right-4 sm:grid-cols-[1fr_auto] sm:items-end sm:p-0">
          <div class="rounded-md bg-white/95 p-3 text-navy shadow-xl sm:p-4">
            <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-green sm:text-sm">Free estimate</p>
            <p class="mt-1 text-base font-bold sm:text-xl">Tell us what you need and get a clear next step.</p>
          </div>
          <div class="hidden rounded-md bg-navy p-4 text-white shadow-xl ring-1 ring-white/10 sm:block">
            <p class="text-3xl font-extrabold">{services.length}</p>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#d8ead3]">Core services</p>
          </div>
        </div>
      </div>

      <div class="absolute -right-2 top-6 hidden w-56 rounded-lg bg-white p-4 text-navy shadow-2xl ring-1 ring-slate-200 lg:block">
        <div class="flex items-center gap-3">
          <span class="flex size-10 items-center justify-center rounded-full bg-mist text-green">
            <Icon name="shield" class="size-5" strokeWidth={2} />
          </span>
          <div>
            <p class="font-extrabold">Fully Insured</p>
            <p class="text-xs text-slate-500">Built for trust</p>
          </div>
        </div>
      </div>

      <div class="mt-4 rounded-lg bg-white p-4 shadow-2xl ring-1 ring-slate-200 lg:ml-8 lg:w-72">
        <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-green">Simple next step</p>
        <p class="mt-1 text-lg font-bold text-navy">Request by WhatsApp, phone, or form.</p>
      </div>
    </div>
  </div>
</section>
