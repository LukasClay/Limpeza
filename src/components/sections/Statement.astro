---
import { brand } from "../../data/brand";
---

<section class="bg-navy py-14 text-white md:py-16">
  <div class="section-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
    <div>
      <h2 class="max-w-3xl text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
        {brand.statement}
      </h2>
      <p class="mt-4 max-w-2xl text-base leading-7 text-slate-200">
        A clean space is more than appearance. It is comfort, peace of mind, and time back in your day.
      </p>
    </div>
    <a
      href="#contact"
      class="hover-lift inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 text-base font-extrabold text-navy transition hover:-translate-y-0.5 hover:bg-mist"
    >
      Get Free Estimate
    </a>
  </div>
</section>
