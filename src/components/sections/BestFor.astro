---
import { bestFor } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section class="bg-white py-16 md:py-20" aria-labelledby="best-for-title">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">Best For</p>
      <h2 id="best-for-title" class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        Choose the cleaning that fits your moment.
      </h2>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        bestFor.map((item) => (
          <article class="reveal rounded-lg border border-slate-200 bg-mist p-5">
            <div class="flex size-10 items-center justify-center rounded-md bg-white text-green shadow-sm">
              <Icon name={item.icon} class="size-5" strokeWidth={1.9} />
            </div>
            <h3 class="mt-5 text-lg font-bold text-navy">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
