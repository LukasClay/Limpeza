---
import { trustCards } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="why-us" class="bg-mist py-16 md:py-24" aria-labelledby="why-us-title">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">Why Us</p>
      <h2 id="why-us-title" class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        What you can expect from ALL PRO Cleaning Services.
      </h2>
      <p class="mt-4 text-lg text-muted">
        A cleaner, simpler process from the first message to the finished space.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-3">
      {
        trustCards.map((card) => (
          <article class="reveal rounded-lg border border-slate-200 bg-white p-5 shadow-[0_10px_30px_rgba(15,31,61,0.05)] sm:p-7">
            <div class="flex size-11 items-center justify-center rounded-md bg-mist text-green">
              <Icon name={card.icon} />
            </div>
            <h3 class="mt-5 text-xl font-bold text-navy">{card.title}</h3>
            <p class="mt-3 leading-7 text-muted">{card.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
