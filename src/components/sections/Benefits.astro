---
import { benefits } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="benefits" class="bg-white py-16 md:py-24" aria-labelledby="benefits-title">
  <div class="section-shell">
    <div class="grid gap-6 md:grid-cols-[0.82fr_1.18fr] md:items-end">
      <div>
        <p class="eyebrow">Why it works</p>
        <h2 id="benefits-title" class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
          A simpler way to get your space professionally cleaned.
        </h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-muted sm:text-lg sm:leading-8 md:justify-self-end">
        From the first message to the finished space, the process is built around clarity, practical options, and a cleaner result you can see.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        benefits.map((benefit) => (
          <article class="reveal rounded-lg border border-slate-200 bg-mist p-5 shadow-[0_10px_30px_rgba(15,31,61,0.04)] sm:p-6">
            <div class="flex size-11 items-center justify-center rounded-md bg-white text-green shadow-sm">
              <Icon name={benefit.icon} />
            </div>
            <h3 class="mt-5 text-xl font-bold text-navy">{benefit.title}</h3>
            <p class="mt-3 leading-7 text-muted">{benefit.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
