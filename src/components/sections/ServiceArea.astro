---
import { serviceCities } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="service-area" class="bg-white py-16 md:py-24">
  <div class="section-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
    <div class="reveal max-w-xl">
      <p class="eyebrow">Service Area</p>
      <h2 class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        Cleaning across Massachusetts.
      </h2>
      <p class="mt-5 text-base leading-7 text-muted sm:text-lg sm:leading-8">
        We cover the Greater Boston, MetroWest, and Worcester areas. If your city is not on our
        list, send us a message — we may still be able to help.
      </p>
      <a
        href="#contact"
        class="hover-lift mt-6 inline-flex min-h-12 items-center justify-center rounded-md bg-green px-5 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-green-dark"
      >
        Check my area
      </a>
    </div>

    <ul class="reveal grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-3 xl:grid-cols-4" role="list">
      {
        serviceCities.map((city) => (
          <li class="flex items-center gap-2 rounded-md border border-slate-200 bg-mist px-3 py-2 text-sm font-bold text-navy">
            <Icon name="map" class="size-4 text-green" strokeWidth={2} />
            {city}
          </li>
        ))
      }
    </ul>
  </div>
</section>
