---
import { faqItems } from "../../data/site";
import Icon from "../ui/Icon.astro";
---

<section id="faq" class="bg-mist py-16 md:py-24">
  <div class="section-shell">
    <div class="max-w-3xl">
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-3 text-3xl font-bold leading-tight text-navy sm:text-4xl md:text-5xl">
        Common questions, clear answers.
      </h2>
      <p class="mt-4 text-lg text-muted">
        Still in doubt? Message us on WhatsApp — we usually reply in under an hour.
      </p>
    </div>

    <div class="mt-10 grid gap-3">
      {
        faqItems.map((item) => (
          <details class="group reveal rounded-lg border border-slate-200 bg-white p-5 shadow-[0_8px_24px_rgba(15,31,61,0.04)] open:shadow-[0_14px_36px_rgba(15,31,61,0.08)]">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 text-left">
              <span class="text-base font-bold text-navy sm:text-lg">{item.question}</span>
              <span class="mt-1 flex size-7 shrink-0 items-center justify-center rounded-full bg-mist text-green transition group-open:rotate-45">
                <Icon name="plus" class="size-4" strokeWidth={2.5} />
              </span>
            </summary>
            <p class="mt-4 leading-7 text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
