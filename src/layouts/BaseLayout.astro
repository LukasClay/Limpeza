---
import "../styles/global.css";
import { SITE_URL } from "../data/brand";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
};

const defaultTitle =
  "ALL PRO Cleaning Services | Residential & Commercial Cleaning in Massachusetts";
const defaultDescription =
  "Professional residential and commercial cleaning services in Massachusetts. Fully insured, reliable, and available for weekly, bi-weekly, monthly, move-in, move-out, and post-construction cleaning.";

const {
  title = defaultTitle,
  description = defaultDescription,
  noindex = false,
  ogImage = `${SITE_URL}/og-image.jpg`,
  jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0B1F33" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/fonts/montserrat-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cinzel-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    {jsonLd && <script is:inline type="application/ld+json" nonce={Astro.locals.cspNonce} set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
  </head>
  <body class="antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-md focus:bg-navy focus:px-4 focus:py-3 focus:text-sm focus:font-extrabold focus:text-white focus:shadow-lg"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // Opt the page in to the .reveal animation only once the script is
      // running. Until then (and if it ever fails), the CSS keeps content
      // visible — see the .reveal rules in global.css.
      const elements = document.querySelectorAll<HTMLElement>(".reveal");
      if (elements.length > 0) {
        document.documentElement.classList.add("reveal-armed");

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );

        elements.forEach((el, index) => {
          const groupIndex = index % 6;
          el.style.setProperty("--reveal-delay", `${groupIndex * 70}ms`);
          observer.observe(el);
        });
      }
    </script>
  </body>
</html>
