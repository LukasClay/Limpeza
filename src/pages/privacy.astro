---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileCTA from "../components/ui/MobileCTA.astro";
import { brand } from "../data/brand";

const lastUpdated = "April 25, 2026";
---

<BaseLayout
  title="Privacy Policy | ALL PRO Cleaning Services"
  description="How ALL PRO Cleaning Services collects, uses, and protects your information."
>
  <Header />
  <main class="bg-white pt-16 md:pt-[72px]">
    <article class="section-shell prose-style py-16 md:py-24">
      <p class="eyebrow">Legal</p>
      <h1 class="mt-3 text-3xl font-bold text-navy sm:text-4xl md:text-5xl">Privacy Policy</h1>
      <p class="mt-3 text-sm text-muted">Last updated: {lastUpdated}</p>

      <p class="mt-8">
        ALL PRO Cleaning Services ("we", "us", "our") respects your privacy. This page explains
        what information we collect through this website, how we use it, and your rights.
      </p>

      <h2>Information we collect</h2>
      <p>
        When you submit our estimate form or contact us through WhatsApp, phone, or email, we
        receive the information you provide, such as your name, phone number, email address,
        ZIP code, service of interest, and any message you choose to send.
      </p>
      <p>
        We do not place tracking cookies and we do not use third-party analytics or advertising
        pixels on this site at this time. If we add analytics in the future, this page will be
        updated.
      </p>

      <h2>How we use your information</h2>
      <ul>
        <li>To respond to your estimate request or question.</li>
        <li>To schedule a cleaning service if you choose to hire us.</li>
        <li>To improve our service quality and follow up about your experience.</li>
      </ul>
      <p>
        We do not sell, rent, or share your personal information with third parties for marketing
        purposes.
      </p>

      <h2>Data storage and security</h2>
      <p>
        Estimate requests are delivered to our team by email. We take reasonable steps to protect
        your information against loss, misuse, or unauthorized access. No internet transmission
        is 100% secure, so we cannot guarantee absolute security.
      </p>

      <h2>Your choices</h2>
      <p>
        You may ask us at any time to access, correct, or delete the personal information you
        provided to us. To make a request, contact us at
        <a href={`mailto:${brand.email}`}>{brand.email}</a> or by phone at
        <a href={brand.phoneHref}>{brand.phoneDisplay}</a>.
      </p>

      <h2>Children</h2>
      <p>
        This website is intended for adults seeking cleaning services. We do not knowingly
        collect personal information from children under 13.
      </p>

      <h2>Updates to this policy</h2>
      <p>
        We may update this policy from time to time. The "last updated" date at the top of the
        page reflects the most recent change. Continued use of the site after updates means you
        accept the revised policy.
      </p>

      <h2>Contact</h2>
      <p>
        Questions about privacy? Reach out at
        <a href={`mailto:${brand.email}`}>{brand.email}</a> or
        <a href={brand.phoneHref}>{brand.phoneDisplay}</a>.
      </p>
    </article>
  </main>
  <Footer />
  <MobileCTA />
</BaseLayout>

<style is:global>
  .prose-style {
    max-width: 720px;
    color: var(--color-muted);
    line-height: 1.75;
  }
  .prose-style h2 {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-navy);
  }
  .prose-style p,
  .prose-style ul {
    margin-bottom: 1rem;
  }
  .prose-style ul {
    padding-left: 1.5rem;
    list-style: disc;
  }
  .prose-style a {
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: underline;
  }
  .prose-style a:hover {
    color: var(--color-green-dark);
  }
</style>
