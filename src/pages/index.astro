---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import Services from "../components/sections/Services.astro";
import Statement from "../components/sections/Statement.astro";
import About from "../components/sections/About.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import ServiceArea from "../components/sections/ServiceArea.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
import MobileCTA from "../components/ui/MobileCTA.astro";
import { brand, SITE_URL } from "../data/brand";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HouseCleaningService"],
  name: brand.name,
  telephone: brand.phoneDisplay,
  email: brand.email,
  url: SITE_URL,
  logo: `${SITE_URL}${brand.logo}`,
  image: `${SITE_URL}${brand.heroImage}`,
  sameAs: [brand.instagramHref, `https://wa.me/${brand.whatsappNumber}`],
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Massachusetts",
  },
  serviceType: [
    "Residential Cleaning",
    "Commercial Cleaning",
    "Move In Cleaning",
    "Move Out Cleaning",
    "Post Construction Cleaning",
  ],
  description:
    "Professional residential and commercial cleaning services in Massachusetts. Fully insured, reliable, and available for weekly, bi-weekly, monthly, move-in, move-out, and post-construction cleaning.",
};
---

<BaseLayout jsonLd={localBusinessSchema}>
  <Header />
  <main id="home" class="pt-16 md:pt-[72px]">
    <Hero />
    <TrustBar />
    <Services />
    <Statement />
    <About />
    <WhyUs />
    <ServiceArea />
    <Faq />
    <Contact />
  </main>
  <Footer />
  <MobileCTA />
</BaseLayout>
