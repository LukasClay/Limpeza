---
import "../styles/global.css";

const brand = {
  name: "ALL PRO Cleaning Services",
  shortName: "ALL PRO",
  tagline: "Not just clean. ALL PRO clean.",
  statement: "Clean spaces. Better living.",
  phoneDisplay: "(617) 955-4047",
  phoneHref: "tel:+16179554047",
  email: "allprocleaninginc1@gmail.com",
  instagram: "@allprocleaninginc1",
  instagramHref: "https://www.instagram.com/allprocleaninginc1",
  area: "Serving Massachusetts",
  logo: "/brand/logo-primary.png",
  board: "/brand/variation-board.png",
};

const services = [
  { icon: "sparkles", title: "Weekly", label: "Weekly Cleaning" },
  { icon: "refresh", title: "Bi-weekly", label: "Bi-weekly Cleaning" },
  { icon: "calendar", title: "Monthly", label: "Monthly Cleaning" },
  { icon: "key", title: "Move in", label: "Move In" },
  { icon: "home", title: "Move out", label: "Move Out" },
  { icon: "building", title: "Post Construction", label: "Post Construction" },
] as const;

const iconPaths = {
  sparkles: [
    "M12 3l1.7 4.6L18 9.3l-4.3 1.7L12 16l-1.7-5L6 9.3l4.3-1.7L12 3z",
    "M5 14l.9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14z",
    "M19 14l.7 1.8L22 16.5l-2.3.7L19 19l-.7-1.8-2.3-.7 2.3-.7L19 14z",
  ],
  refresh: [
    "M21 12a9 9 0 0 1-15.4 6.4",
    "M3 12A9 9 0 0 1 18.4 5.6",
    "M18 2v4h-4",
    "M6 22v-4h4",
  ],
  calendar: [
    "M7 3v4",
    "M17 3v4",
    "M4 9h16",
    "M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z",
  ],
  key: [
    "M15 7a4 4 0 1 1 2.8 6.8L14 17.6V21h-4v-3H7v-4h3.4l3.8-3.8A4 4 0 0 1 15 7z",
    "M18 7h.01",
  ],
  home: [
    "M3 11l9-8 9 8",
    "M5 10v10h14V10",
    "M9 20v-6h6v6",
  ],
  building: [
    "M4 21V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v16",
    "M17 9h2a2 2 0 0 1 2 2v10",
    "M8 7h1",
    "M12 7h1",
    "M8 11h1",
    "M12 11h1",
    "M8 15h1",
    "M12 15h1",
    "M3 21h19",
  ],
} as const;

const trustItems = [
  { title: "Fully Insured", text: "Proof of confidence" },
  { title: "Trusted Professionals", text: "A team you can count on" },
  { title: "Reliable", text: "Always on time" },
  { title: "Thorough", text: "Attention to detail" },
] as const;

const reviews = [
  {
    text: "They were professional, careful, and the house looked spotless.",
    name: "Residential client",
  },
  {
    text: "Clear communication, fair estimate, and reliable service for our space.",
    name: "Commercial client",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="ALL PRO Cleaning Services offers residential and commercial cleaning in Massachusetts with free estimates and fully insured service."
    />
    <title>{brand.name} | Residential & Commercial Cleaning</title>
  </head>
  <body class="antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-[#eef3ee] bg-[#ffffff]">
      <div class="section-shell flex h-20 items-center justify-between gap-4">
        <a href="#home" class="flex items-center gap-3" aria-label={`${brand.name} home`}>
          <img src={brand.logo} alt={brand.name} class="h-14 w-auto mix-blend-multiply" width="240" height="220" />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-bold text-[#1e2f5a] md:flex" aria-label="Primary navigation">
          <a class="transition hover:text-[#4f913f]" href="#home">Home</a>
          <a class="transition hover:text-[#4f913f]" href="#services">Services</a>
          <a class="transition hover:text-[#4f913f]" href="#about">About</a>
          <a class="transition hover:text-[#4f913f]" href="#contact">Contact</a>
        </nav>

        <a
          href={brand.phoneHref}
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#6baf5b] px-4 text-sm font-extrabold text-white shadow-sm transition hover:bg-[#4f913f]"
        >
          CALL NOW
        </a>
      </div>
    </header>

    <main id="home" class="pt-20">
      <section class="relative overflow-hidden bg-[#1e2f5a] text-white">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(107,175,91,0.25),transparent_28%),linear-gradient(135deg,#1e2f5a_0%,#0f1f3d_60%,#08172e_100%)]"></div>
        <div class="section-shell relative grid min-h-[calc(100svh-80px)] items-center gap-12 py-14 md:grid-cols-[0.96fr_1.04fr] md:py-18">
          <div class="max-w-2xl">
            <p class="mb-5 inline-flex rounded-md bg-white/10 px-3 py-2 text-sm font-bold uppercase tracking-[0.14em] text-[#d8ead3] ring-1 ring-white/15">
              Residential & Commercial
            </p>
            <h1 class="text-5xl font-bold leading-tight md:text-6xl">
              A clean space. A better place.
            </h1>
            <p class="mt-6 max-w-xl text-xl font-semibold italic leading-8 text-[#d8ead3]">
              {brand.tagline}
            </p>
            <p class="mt-4 max-w-xl text-lg leading-8 text-slate-100">
              Premium accessible cleaning for homes, offices, move-ins, move-outs, and
              post-construction spaces across Massachusetts.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href={brand.phoneHref}
                class="inline-flex min-h-12 items-center justify-center rounded-md bg-[#6baf5b] px-6 text-base font-extrabold text-white transition hover:bg-[#4f913f]"
              >
                CALL {brand.phoneDisplay}
              </a>
              <a
                href="#contact"
                class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/30 px-6 text-base font-extrabold text-white transition hover:bg-white hover:text-[#1e2f5a]"
              >
                GET FREE ESTIMATE
              </a>
            </div>
          </div>

          <div class="relative">
            <div class="hero-shadow rounded-lg bg-white p-6 md:p-8">
              <img
                src={brand.logo}
                alt={brand.name}
                class="mx-auto max-h-[360px] w-full object-contain"
                loading="eager"
                width="1080"
                height="1180"
              />
              <div class="mt-6 rounded-md bg-[#6baf5b] px-4 py-3 text-center text-lg font-bold italic text-white">
                Residential & Commercial
              </div>
            </div>
            <div class="absolute -bottom-5 left-4 right-4 rounded-md bg-[#0f1f3d] px-5 py-4 shadow-xl ring-1 ring-white/10 sm:left-auto sm:right-6 sm:w-72">
              <p class="text-sm font-extrabold text-[#d8ead3]">Free estimates</p>
              <p class="mt-1 text-sm text-white">{brand.phoneDisplay} | Fully insured</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Trust badges" class="border-b border-[#dfe8df] bg-white">
        <div class="section-shell grid grid-cols-2 gap-4 py-6 md:grid-cols-4">
          {
            trustItems.map((item) => (
              <div class="flex items-start gap-3 text-sm text-[#1e2f5a]">
                <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-[#ecf2ed] text-[#4f913f]">
                  ✓
                </span>
                <span>
                  <strong class="block">{item.title}</strong>
                  <span class="text-slate-500">{item.text}</span>
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="services" class="bg-white py-20 md:py-24">
        <div class="section-shell">
          <div class="max-w-2xl">
            <p class="text-sm font-extrabold uppercase text-[#4f913f]">Our Services</p>
            <h2 class="mt-3 text-4xl font-bold text-[#1e2f5a] md:text-5xl">Professional cleaning made simple.</h2>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              services.map((service) => (
                <article class="rounded-lg border border-[#dfe8df] bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                  <div class="mb-5 flex size-12 items-center justify-center rounded-full bg-[#6baf5b] text-white">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="size-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      {iconPaths[service.icon].map((path) => <path d={path} />)}
                    </svg>
                  </div>
                  <h3 class="text-2xl font-bold text-[#1e2f5a]">{service.title}</h3>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-[#ecf2ed] py-16">
        <div class="section-shell">
          <p class="mx-auto max-w-4xl text-center text-4xl font-bold leading-tight text-[#1e2f5a] md:text-5xl">
            {brand.statement}
          </p>
        </div>
      </section>

      <section id="contact" class="bg-[#1e2f5a] py-20 text-white md:py-24">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.82fr_1.18fr]">
          <div>
            <p class="text-sm font-extrabold uppercase text-[#d8ead3]">Free estimates</p>
            <h2 class="mt-3 text-4xl font-bold md:text-5xl">Ready for an ALL PRO clean?</h2>
            <p class="mt-5 text-lg leading-8 text-slate-100">
              Tell us what you need and we will follow up quickly with a clear estimate for your
              home or commercial space.
            </p>
            <div class="mt-8 grid gap-3 text-base text-slate-100">
              <a class="font-bold text-white hover:text-[#d8ead3]" href={brand.phoneHref}>{brand.phoneDisplay}</a>
              <a class="font-bold text-white hover:text-[#d8ead3]" href={`mailto:${brand.email}`}>{brand.email}</a>
              <a class="font-bold text-white hover:text-[#d8ead3]" href={brand.instagramHref}>{brand.instagram}</a>
              <p>{brand.area}</p>
            </div>
          </div>

          <form class="grid gap-4 rounded-lg bg-white p-5 text-[#102132] shadow-2xl md:grid-cols-2 md:p-8">
            <label class="grid gap-2 text-sm font-bold">
              Name
              <input class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" type="text" name="name" autocomplete="name" />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Phone
              <input class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" type="tel" name="phone" autocomplete="tel" />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Email
              <input class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" type="email" name="email" autocomplete="email" />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Service
              <select class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" name="service">
                {services.map((service) => <option>{service.label}</option>)}
              </select>
            </label>
            <label class="grid gap-2 text-sm font-bold md:col-span-2">
              Message
              <textarea class="min-h-32 rounded-md border border-slate-300 px-4 py-3 font-normal" name="message"></textarea>
            </label>
            <button
              type="submit"
              class="min-h-12 rounded-md bg-[#6baf5b] px-6 text-base font-extrabold text-white transition hover:bg-[#4f913f] md:col-span-2"
            >
              GET FREE ESTIMATE
            </button>
          </form>
        </div>
      </section>

      <section id="about" class="bg-white py-20 md:py-24">
        <div class="section-shell grid gap-8 md:grid-cols-[0.72fr_1fr] md:items-center">
          <p class="text-sm font-extrabold uppercase text-[#4f913f]">About</p>
          <div>
            <h2 class="text-4xl font-bold text-[#1e2f5a] md:text-5xl">Premium accessible cleaning.</h2>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
              ALL PRO Cleaning Services brings a consistent, professional visual standard to the
              way we clean: clear communication, careful details, and spaces that feel ready to live
              or work in.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-[#ecf2ed] py-20 md:py-24" aria-labelledby="reviews-title">
        <div class="section-shell">
          <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
              <p class="text-sm font-extrabold uppercase text-[#4f913f]">Reviews</p>
              <h2 id="reviews-title" class="mt-3 text-4xl font-bold text-[#1e2f5a] md:text-5xl">
                Quality you can count on.
              </h2>
            </div>
            <a
              href="#contact"
              class="inline-flex min-h-12 items-center justify-center rounded-md bg-[#1e2f5a] px-6 text-base font-extrabold text-white transition hover:bg-[#0f1f3d]"
            >
              GET FREE ESTIMATE
            </a>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-2">
            {
              reviews.map((review) => (
                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-[#dfe8df]">
                  <p class="text-lg leading-8 text-slate-700">&ldquo;{review.text}&rdquo;</p>
                  <p class="mt-5 font-bold text-[#1e2f5a]">{review.name}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#1e2f5a] pb-24 pt-12 text-white md:pb-12">
      <div class="section-shell grid gap-8 md:grid-cols-[0.75fr_1.5fr]">
        <div>
          <img src={brand.logo} alt={brand.name} class="max-h-28 w-auto rounded-md bg-white p-3" width="240" height="220" />
          <p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">{brand.tagline}</p>
        </div>
        <div class="grid gap-4 text-sm text-slate-200 sm:grid-cols-2">
          <p><span class="font-bold text-white">Phone:</span> {brand.phoneDisplay}</p>
          <p><span class="font-bold text-white">Email:</span> {brand.email}</p>
          <p><span class="font-bold text-white">Instagram:</span> {brand.instagram}</p>
          <p><span class="font-bold text-white">Service area:</span> Massachusetts</p>
        </div>
      </div>
    </footer>

    <a
      href={brand.phoneHref}
      class="fixed inset-x-4 bottom-4 z-50 flex min-h-14 items-center justify-center rounded-md bg-[#6baf5b] text-base font-extrabold text-white shadow-2xl md:hidden"
      aria-label={`Call ${brand.name} now`}
    >
      CALL NOW
    </a>
  </body>
</html>
