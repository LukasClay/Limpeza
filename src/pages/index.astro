---
import "../styles/global.css";

const brand = {
  name: "ALL PRO Cleaning Services",
  shortName: "ALL PRO",
  tagline: "Not just clean. ALL PRO clean.",
  statement: "Clean spaces. Better living.",
  primaryCta: "Get My Free Estimate",
  phoneDisplay: "(617) 955-4047",
  phoneHref: "tel:+16179554047",
  email: "allprocleaninginc1@gmail.com",
  instagram: "@allprocleaninginc1",
  instagramHref: "https://www.instagram.com/allprocleaninginc1",
  area: "Serving Massachusetts",
  logo: "/brand/logo-primary.png",
  heroImage: "/hero-cleaning.png",
};

const navItems = [
  { label: "Services", href: "#services" },
  { label: "About", href: "#about" },
  { label: "Trust", href: "#trust" },
  { label: "Contact", href: "#contact" },
] as const;

const services = [
  {
    icon: "sparkles",
    title: "Weekly Cleaning",
    label: "Weekly Cleaning",
    text: "Keep your home clean without spending your weekends catching up.",
    ideal: "Busy households",
    cta: "Estimate weekly cleaning",
  },
  {
    icon: "refresh",
    title: "Bi-weekly Cleaning",
    label: "Bi-weekly Cleaning",
    text: "A reliable routine that keeps rooms ready between deeper resets.",
    ideal: "Steady upkeep",
    cta: "Estimate bi-weekly cleaning",
  },
  {
    icon: "calendar",
    title: "Monthly Cleaning",
    label: "Monthly Cleaning",
    text: "A deeper reset for homes or offices that need a periodic refresh.",
    ideal: "Fresh resets",
    cta: "Estimate monthly cleaning",
  },
  {
    icon: "key",
    title: "Move In Cleaning",
    label: "Move In",
    text: "Start with a clean space before furniture and boxes take over.",
    ideal: "New homes and apartments",
    cta: "Estimate move-in cleaning",
  },
  {
    icon: "home",
    title: "Move Out Cleaning",
    label: "Move Out",
    text: "Leave the property ready for inspection, listing, or the next tenant.",
    ideal: "Tenants, landlords, property managers",
    cta: "Estimate move-out cleaning",
  },
  {
    icon: "building",
    title: "Post Construction",
    label: "Post Construction",
    text: "Remove dust, debris, and residue after renovation work.",
    ideal: "Renovations and builds",
    cta: "Estimate post-construction cleaning",
  },
  {
    icon: "building",
    title: "Commercial Cleaning",
    label: "Commercial Cleaning",
    text: "Keep client-facing and team spaces presentable with a clear cleaning plan.",
    ideal: "Offices and small businesses",
    cta: "Estimate commercial cleaning",
  },
] as const;

const serviceOptions = [
  "Weekly Cleaning",
  "Bi-weekly Cleaning",
  "Monthly Cleaning",
  "Move In",
  "Move Out",
  "Post Construction",
  "Commercial Cleaning",
] as const;

const trustBar = [
  { icon: "estimate", title: "Clear Estimates", text: "No confusing back-and-forth" },
  { icon: "clock", title: "Simple Scheduling", text: "Know what happens next" },
  { icon: "home", title: "Homes & Businesses", text: "Residential and commercial" },
  { icon: "map", title: "Serving Massachusetts", text: "Local service area" },
] as const;

const aboutPoints = [
  { icon: "shield", title: "Insured" },
  { icon: "clock", title: "Reliable" },
  { icon: "sparkles", title: "Detail-Oriented" },
  { icon: "users", title: "Professional" },
] as const;

const processItems = [
  {
    title: "Request",
    text: "Send your service type, ZIP Code, and a few details.",
  },
  {
    title: "Estimate",
    text: "Get a clear next step without confusing back-and-forth.",
  },
  {
    title: "Schedule",
    text: "Choose the best visit window for your home or business.",
  },
  {
    title: "Clean Space",
    text: "Enjoy a space that feels ready again.",
  },
] as const;

const bestFor = [
  { icon: "refresh", title: "Busy routine", text: "Weekly or bi-weekly cleaning keeps your home consistently fresh." },
  { icon: "sparkles", title: "Fresh reset", text: "Monthly cleaning helps restore order when the space needs deeper attention." },
  { icon: "key", title: "Moving day", text: "Move-in and move-out cleaning make handoff feel simpler." },
  { icon: "building", title: "After renovation", text: "Post-construction cleanup helps remove dust and surface buildup." },
  { icon: "home", title: "Business space", text: "Commercial cleaning keeps offices and shared areas ready for people." },
] as const;

const trustCards = [
  {
    icon: "shield",
    title: "Fully insured",
    text: "Built to give homeowners and businesses confidence before the first visit.",
  },
  {
    icon: "clock",
    title: "Clear communication",
    text: "A simple estimate process and organized follow-up from the start.",
  },
  {
    icon: "sparkles",
    title: "Professional standard",
    text: "Careful attention to detail for residential and commercial spaces.",
  },
] as const;

const iconPaths = {
  sparkles: [
    "M12 3l1.7 4.6L18 9.3l-4.3 1.7L12 16l-1.7-5L6 9.3l4.3-1.7L12 3z",
    "M5 14l.9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14z",
    "M19 14l.7 1.8L22 16.5l-2.3.7L19 19l-.7-1.8-2.3-.7 2.3-.7L19 14z",
  ],
  refresh: ["M21 12a9 9 0 0 1-15.4 6.4", "M3 12A9 9 0 0 1 18.4 5.6", "M18 2v4h-4", "M6 22v-4h4"],
  calendar: ["M7 3v4", "M17 3v4", "M4 9h16", "M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"],
  key: ["M15 7a4 4 0 1 1 2.8 6.8L14 17.6V21h-4v-3H7v-4h3.4l3.8-3.8A4 4 0 0 1 15 7z", "M18 7h.01"],
  home: ["M3 11l9-8 9 8", "M5 10v10h14V10", "M9 20v-6h6v6"],
  building: ["M4 21V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v16", "M17 9h2a2 2 0 0 1 2 2v10", "M8 7h1", "M12 7h1", "M8 11h1", "M12 11h1", "M8 15h1", "M12 15h1", "M3 21h19"],
  shield: ["M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6l7-3z", "M9 12l2 2 4-5"],
  estimate: ["M7 4h10a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2V6a2 2 0 0 1 2-2z", "M9 9h6", "M9 13h6"],
  map: ["M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3z", "M9 3v15", "M15 6v15"],
  clock: ["M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z", "M12 7v5l3 2"],
  phone: ["M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L7.7 9.8a16 16 0 0 0 6.5 6.5l1.3-1.3a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2z"],
  users: ["M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2", "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z", "M22 21v-2a4 4 0 0 0-3-3.9", "M16 3.1a4 4 0 0 1 0 7.8"],
  star: ["M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 16.9 6.6 19.8l1-6.1-4.4-4.3 6.1-.9L12 3z"],
} as const;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HouseCleaningService"],
  name: brand.name,
  telephone: brand.phoneDisplay,
  email: brand.email,
  logo: brand.logo,
  image: brand.heroImage,
  sameAs: [brand.instagramHref],
  contactPoint: {
    "@type": "ContactPoint",
    telephone: brand.phoneDisplay,
    contactType: "customer service",
    areaServed: "US-MA",
    availableLanguage: ["English", "Portuguese"],
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Massachusetts",
  },
  serviceType: [
    "Residential Cleaning",
    "Commercial Cleaning",
    "Move In Cleaning",
    "Move Out Cleaning",
    "Post Construction Cleaning",
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Cleaning services",
    itemListElement: services.map((service) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: service.title,
        description: service.text,
        areaServed: "Massachusetts",
      },
    })),
  },
  description:
    "Professional residential and commercial cleaning services in Massachusetts. Fully insured, reliable, and available for weekly, bi-weekly, monthly, move-in, move-out, and post-construction cleaning.",
};

const pageTitle = "ALL PRO Cleaning Services | Residential & Commercial Cleaning in Massachusetts";
const pageDescription =
  "Professional residential and commercial cleaning services in Massachusetts. Fully insured, reliable, and available for weekly, bi-weekly, monthly, move-in, move-out, and post-construction cleaning.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={pageDescription}
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={brand.heroImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={brand.heroImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <title>{pageTitle}</title>
  </head>
  <body class="antialiased">
    <a class="skip-link" href="#home">Skip to content</a>
    <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-[0_1px_18px_rgba(15,23,42,0.06)] backdrop-blur-xl">
      <div class="section-shell flex h-16 items-center justify-between gap-3 md:h-[72px] md:gap-4">
        <a href="#home" class="flex items-center gap-3" aria-label={`${brand.name} home`}>
          <img src={brand.logo} alt={brand.name} class="h-10 w-auto mix-blend-multiply md:h-12" width="240" height="220" />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-bold text-[#0B1F33] lg:flex" aria-label="Primary navigation">
          {navItems.map((item) => <a class="transition hover:text-[#2E7D32]" href={item.href}>{item.label}</a>)}
        </nav>

        <div class="hidden items-center gap-3 md:flex">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-slate-200 px-4 text-sm font-extrabold text-[#0B1F33] transition hover:border-[#2E7D32] hover:text-[#2E7D32]"
            href={brand.phoneHref}
            aria-label={`Call ${brand.name} at ${brand.phoneDisplay}`}
          >
            Call Now
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#2E7D32] px-5 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(46,125,50,0.24)] transition hover:-translate-y-0.5 hover:bg-[#2EB872]"
          >
            {brand.primaryCta}
          </a>
        </div>

        <details class="mobile-menu relative lg:hidden">
          <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md border border-slate-200 text-[#0B1F33]">
            <span class="sr-only">Open menu</span>
            <span class="block h-0.5 w-5 bg-current before:relative before:-top-1.5 before:block before:h-0.5 before:bg-current after:relative after:top-1 after:block after:h-0.5 after:bg-current"></span>
          </summary>
          <div class="absolute right-0 top-12 w-[min(86vw,320px)] rounded-lg border border-slate-200 bg-white p-3 shadow-2xl md:top-14">
            {navItems.map((item) => <a class="block rounded-md px-4 py-3 text-sm font-bold text-[#0B1F33] hover:bg-[#F4F7F8]" href={item.href}>{item.label}</a>)}
            <a class="mt-2 flex min-h-12 items-center justify-center rounded-md bg-[#2E7D32] px-4 text-sm font-extrabold text-white" href="#contact">
              {brand.primaryCta}
            </a>
          </div>
        </details>
      </div>
    </header>

    <main id="home" class="pt-16 md:pt-[72px]">
      <section class="relative overflow-hidden bg-[#0B1F33] text-white">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(46,184,114,0.16),transparent_30%),linear-gradient(135deg,#0B1F33_0%,#11294A_58%,#07172A_100%)]"></div>
        <div class="section-shell relative grid gap-10 py-10 sm:py-12 md:grid-cols-[0.92fr_1.08fr] md:py-16 lg:min-h-[calc(100svh-72px)] lg:py-20">
          <div class="reveal max-w-2xl text-white">
            <p class="inline-flex rounded-md border border-white/15 bg-white/10 px-3 py-2 text-xs font-extrabold uppercase tracking-[0.16em] text-[#d8ead3]">
              {brand.tagline}
            </p>
            <h1 class="mt-5 text-[clamp(2.35rem,9.2vw,4.4rem)] font-bold leading-[1.04] md:mt-6 md:text-6xl lg:text-7xl">
              Reliable Cleaning Services in Massachusetts
            </h1>
            <p class="mt-5 max-w-xl text-base leading-7 text-slate-100 sm:text-lg md:mt-6 md:text-xl md:leading-8">
              Professional residential, commercial, move-in, move-out, and post-construction
              cleaning with clear estimates and simple scheduling.
            </p>
            <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300 sm:text-base sm:leading-7">
              Tell us what you need, get a clear next step, and schedule your cleaning without messy communication.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href="#contact"
                class="inline-flex min-h-[52px] items-center justify-center rounded-md bg-[#2E7D32] px-5 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(46,125,50,0.28)] transition hover:-translate-y-0.5 hover:bg-[#2EB872] sm:px-7"
              >
                {brand.primaryCta}
              </a>
              <a
                href={brand.phoneHref}
                class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-white/25 bg-white/10 px-5 text-base font-extrabold text-white transition hover:bg-white hover:text-[#0B1F33] sm:px-7"
              >
                Call {brand.phoneDisplay}
              </a>
            </div>

            <div class="mt-8 grid gap-3 text-sm font-bold text-slate-100 sm:grid-cols-3">
              {["Clear Estimates", "Simple Scheduling", "Fully Insured"].map((item) => (
                <div class="flex items-center gap-2 rounded-md border border-white/[0.12] bg-white/[0.08] px-3 py-3">
                  <span class="flex size-6 items-center justify-center rounded-full bg-[#2EB872]/20 text-[#d8ead3]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      {iconPaths.shield.map((path) => <path d={path} />)}
                    </svg>
                  </span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="reveal relative mx-auto w-full max-w-2xl md:max-w-none">
            <div class="relative overflow-hidden rounded-lg bg-[#07172A] shadow-[0_34px_90px_rgba(2,8,23,0.32)] ring-1 ring-white/10">
              <img
                src={brand.heroImage}
                alt="Bright clean interior after professional cleaning service"
                class="aspect-[4/3] w-full object-cover opacity-95"
                width="1536"
                height="1024"
                loading="eager"
                fetchpriority="high"
              />
              <div class="absolute inset-0 z-10 bg-gradient-to-t from-[#07172A]/72 via-transparent to-transparent"></div>
              <div class="relative z-20 grid gap-3 p-3 sm:absolute sm:bottom-4 sm:left-4 sm:right-4 sm:grid-cols-[1fr_auto] sm:items-end sm:p-0">
                <div class="rounded-md bg-white/95 p-3 text-[#0B1F33] shadow-xl sm:p-4">
                  <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-[#2E7D32] sm:text-sm">ALL PRO Standard</p>
                  <p class="mt-1 text-base font-bold sm:text-xl">Clean spaces. Better living.</p>
                </div>
                <div class="hidden rounded-md bg-[#0B1F33] p-4 text-white shadow-xl ring-1 ring-white/10 sm:block">
                  <p class="text-3xl font-extrabold">5</p>
                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#d8ead3]">Core services</p>
                </div>
              </div>
            </div>

            <div class="absolute -right-2 top-6 hidden w-56 rounded-lg bg-white p-4 text-[#0B1F33] shadow-2xl ring-1 ring-slate-200 lg:block">
              <div class="flex items-center gap-3">
                <span class="flex size-10 items-center justify-center rounded-full bg-[#F4F7F8] text-[#2E7D32]">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    {iconPaths.shield.map((path) => <path d={path} />)}
                  </svg>
                </span>
                <div>
                  <p class="font-extrabold">Fully Insured</p>
                  <p class="text-xs text-slate-500">Built for trust</p>
                </div>
              </div>
            </div>

            <div class="mt-4 rounded-lg bg-white p-4 shadow-2xl ring-1 ring-slate-200 lg:ml-8 lg:w-72">
              <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#2E7D32]">Fast next step</p>
              <p class="mt-1 text-lg font-bold text-[#0B1F33]">Tell us what you need. We guide the next step.</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Trust badges" class="border-y border-slate-200 bg-white">
        <div class="section-shell grid gap-3 py-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            trustBar.map((item) => (
              <div class="flex items-start gap-3 rounded-lg border border-slate-100 bg-white px-3 py-3 shadow-[0_8px_20px_rgba(15,31,61,0.03)]">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-[#F4F7F8] text-[#2E7D32]">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    {iconPaths[item.icon].map((path) => <path d={path} />)}
                  </svg>
                </span>
                <span>
                  <strong class="block text-sm text-[#0B1F33]">{item.title}</strong>
                  <span class="text-sm text-slate-500">{item.text}</span>
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="services" class="bg-[#F4F7F8] py-16 md:py-24">
        <div class="section-shell">
          <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:items-end">
            <div>
              <p class="eyebrow">Our Services</p>
              <h2 class="mt-3 text-3xl font-bold leading-tight text-[#0B1F33] sm:text-4xl md:text-5xl">Residential & Commercial Cleaning Services</h2>
            </div>
            <p class="max-w-2xl text-base leading-7 text-[#5F6B73] sm:text-lg sm:leading-8 md:justify-self-end">
              Cleaning for homes, offices, moves, and post-construction spaces handled with one
              clear process.
            </p>
          </div>

          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              services.map((service) => (
                <article class="service-card reveal rounded-lg border border-slate-200 bg-white p-5 shadow-[0_10px_30px_rgba(15,31,61,0.05)] transition duration-300 hover:-translate-y-1 hover:border-[#cfdccf] hover:shadow-[0_18px_42px_rgba(15,31,61,0.09)] sm:p-7">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex size-12 items-center justify-center rounded-md bg-[#0B1F33] text-white">
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        {iconPaths[service.icon].map((path) => <path d={path} />)}
                      </svg>
                    </div>
                    <span class="rounded-full bg-[#F4F7F8] px-3 py-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#2E7D32]">
                      ALL PRO Standard
                    </span>
                  </div>
                  <h3 class="mt-7 text-2xl font-bold text-[#0B1F33]">{service.title}</h3>
                  <p class="mt-3 leading-7 text-[#5F6B73]">{service.text}</p>
                  <p class="mt-5 text-sm text-[#5F6B73]">
                    <span class="font-extrabold text-[#0B1F33]">Ideal for:</span> {service.ideal}
                  </p>
                  <a class="mt-6 inline-flex text-sm font-extrabold text-[#2E7D32] transition hover:text-[#0B1F33]" href="#contact">
                    {service.cta}
                  </a>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-white py-16 md:py-20" aria-labelledby="best-for-title">
        <div class="section-shell">
          <div class="max-w-3xl">
            <p class="eyebrow">Best For</p>
            <h2 id="best-for-title" class="mt-3 text-3xl font-bold leading-tight text-[#0B1F33] sm:text-4xl md:text-5xl">
              Choose the cleaning that fits your moment.
            </h2>
          </div>
          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
            {
              bestFor.map((item) => (
                <article class="rounded-lg border border-slate-200 bg-[#F4F7F8] p-5">
                  <div class="flex size-10 items-center justify-center rounded-md bg-white text-[#2E7D32] shadow-sm">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      {iconPaths[item.icon].map((path) => <path d={path} />)}
                    </svg>
                  </div>
                  <h3 class="mt-5 text-lg font-bold text-[#0B1F33]">{item.title}</h3>
                  <p class="mt-3 text-sm leading-6 text-[#5F6B73]">{item.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-[#0B1F33] py-14 text-white md:py-16">
        <div class="section-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <h2 class="max-w-3xl text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">
              {brand.statement}
            </h2>
            <p class="mt-4 max-w-2xl text-base leading-7 text-slate-200">
              A clean space is more than appearance. It is comfort, peace of mind, and time back in your day.
            </p>
          </div>
          <a
            href="#contact"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 text-base font-extrabold text-[#0B1F33] transition hover:-translate-y-0.5 hover:bg-[#F4F7F8]"
          >
            {brand.primaryCta}
          </a>
        </div>
      </section>

      <section id="about" class="bg-white py-16 md:py-24">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="reveal relative">
            <img
              src={brand.heroImage}
              alt="Clean home interior representing professional residential cleaning"
              class="aspect-[4/3] w-full rounded-lg object-cover shadow-[0_24px_70px_rgba(15,31,61,0.16)]"
              width="1536"
              height="1024"
              loading="lazy"
            />
            <div class="mt-4 rounded-lg bg-white p-5 shadow-xl ring-1 ring-slate-200 sm:absolute sm:bottom-4 sm:left-4 sm:right-auto sm:mt-0 sm:w-80 sm:bg-white/95">
              <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-[#2E7D32]">Premium accessible</p>
              <p class="mt-2 text-xl font-bold text-[#0B1F33]">{brand.tagline}</p>
            </div>
          </div>

          <div class="reveal">
            <p class="eyebrow">About ALL PRO</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight text-[#0B1F33] sm:text-4xl md:text-5xl">
              Local cleaning service. Professional standards.
            </h2>
            <p class="mt-5 text-base leading-7 text-[#5F6B73] sm:text-lg sm:leading-8">
              ALL PRO Cleaning Services provides reliable residential and commercial cleaning with
              careful attention to detail, clear communication, and a professional team you can trust.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              {
                aboutPoints.map((point) => (
                  <div class="rounded-lg border border-slate-200 bg-[#F4F7F8] p-4">
                    <div class="flex size-10 items-center justify-center rounded-md bg-white text-[#2E7D32] shadow-sm">
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        {iconPaths[point.icon].map((path) => <path d={path} />)}
                      </svg>
                    </div>
                    <p class="mt-4 font-extrabold text-[#0B1F33]">{point.title}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="trust" class="bg-[#F4F7F8] py-16 md:py-24" aria-labelledby="trust-title">
        <div class="section-shell">
          <div class="max-w-3xl">
            <p class="eyebrow">Trust</p>
            <h2 id="trust-title" class="mt-3 text-3xl font-bold leading-tight text-[#0B1F33] sm:text-4xl md:text-5xl">
              Trusted by local homeowners and businesses.
            </h2>
            <p class="mt-4 text-lg text-[#5F6B73]">
              Reliable, insured cleaning for homes and businesses across Massachusetts.
            </p>
          </div>

          <div class="mt-12 grid gap-4 lg:grid-cols-3">
            {
              trustCards.map((card) => (
                <article class="reveal rounded-lg border border-slate-200 bg-white p-5 shadow-[0_10px_30px_rgba(15,31,61,0.05)] sm:p-7">
                  <div class="flex size-11 items-center justify-center rounded-md bg-[#F4F7F8] text-[#2E7D32]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                      {iconPaths[card.icon].map((path) => <path d={path} />)}
                    </svg>
                  </div>
                  <h3 class="mt-5 text-xl font-bold text-[#0B1F33]">{card.title}</h3>
                  <p class="mt-3 leading-7 text-[#5F6B73]">{card.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="contact" class="bg-[#0B1F33] pb-28 pt-16 text-white md:py-24">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
          <div class="reveal">
            <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-[#d8ead3]">Get started</p>
            <h2 class="mt-3 text-3xl font-bold leading-tight sm:text-4xl md:text-5xl">Request Your Free Estimate</h2>
            <p class="mt-5 text-base leading-7 text-slate-100 sm:text-lg sm:leading-8">
              No pressure. No confusing quote process. Tell us what you need and we will guide
              the next step.
            </p>
            <div class="mt-8 grid gap-3">
              {
                processItems.map((item, index) => (
                  <div class="flex items-start gap-3 rounded-md border border-white/10 bg-white/[0.08] px-4 py-3">
                    <span class="flex size-8 items-center justify-center rounded-full bg-[#2E7D32] text-sm font-extrabold text-white">{index + 1}</span>
                    <span>
                      <strong class="block">{item.title}</strong>
                      <span class="mt-1 block text-sm leading-6 text-slate-200">{item.text}</span>
                    </span>
                  </div>
                ))
              }
            </div>
          </div>

          <form class="reveal grid gap-4 rounded-lg bg-white p-5 text-[#0B1F33] shadow-[0_34px_90px_rgba(2,8,23,0.32)] md:grid-cols-2 md:p-8" aria-label="Free estimate form">
            <div class="hp-field" aria-hidden="true">
              <label>
                Website
                <input type="text" name="website" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <div class="rounded-lg border border-slate-200 bg-[#F4F7F8] p-4 md:col-span-2">
              <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-[#2E7D32]">Step 1 - Your contact</p>
              <div class="mt-4 grid gap-4 md:grid-cols-3">
                <label class="grid gap-2 text-sm font-bold">
                  Name
                  <input class="field" type="text" name="name" autocomplete="name" required />
                </label>
                <label class="grid gap-2 text-sm font-bold">
                  Phone
                  <input class="field" type="tel" name="phone" autocomplete="tel" required />
                </label>
                <label class="grid gap-2 text-sm font-bold">
                  <span>Email <span class="font-medium text-slate-500">(optional)</span></span>
                  <input class="field" type="email" name="email" autocomplete="email" />
                </label>
              </div>
            </div>

            <div class="rounded-lg border border-slate-200 bg-white p-4 md:col-span-2">
              <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-[#2E7D32]">Step 2 - Your cleaning</p>
              <div class="mt-4 grid gap-4 md:grid-cols-[0.62fr_1.38fr]">
                <label class="grid gap-2 text-sm font-bold">
                  ZIP Code
                  <input class="field" type="text" name="zip" inputmode="numeric" autocomplete="postal-code" required />
                </label>
                <div class="grid gap-2 text-sm font-bold">
                  Service Type
                  <div class="grid gap-2 sm:grid-cols-2">
                    {
                      serviceOptions.map((service, index) => (
                        <label class="cursor-pointer">
                          <input class="peer sr-only" type="radio" name="service" value={service} required={index === 0} checked={index === 0} />
                          <span class="block rounded-md border border-slate-200 bg-white px-3 py-3 text-sm font-extrabold text-[#0B1F33] transition hover:border-[#2E7D32] peer-checked:border-[#2E7D32] peer-checked:bg-[#F4F7F8] peer-checked:text-[#2E7D32] peer-focus-visible:ring-4 peer-focus-visible:ring-[#2E7D32]/20">
                            {service}
                          </span>
                        </label>
                      ))
                    }
                  </div>
                </div>
              </div>
              <label class="mt-4 grid gap-2 text-sm font-bold">
                <span>Details <span class="font-medium text-slate-500">(optional)</span></span>
                <textarea class="field min-h-32 py-3" name="message" placeholder="Anything we should know?"></textarea>
              </label>
            </div>

            <div class="rounded-lg border border-slate-200 bg-[#F4F7F8] p-4 md:col-span-2">
              <p class="text-xs font-extrabold uppercase tracking-[0.14em] text-[#2E7D32]">Step 3 - Send request</p>
              <p class="mt-2 text-sm leading-6 text-[#5F6B73]">Usually takes less than 1 minute.</p>
            </div>
            <button
              type="submit"
              class="min-h-[52px] rounded-md bg-[#2E7D32] px-6 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(46,125,50,0.25)] transition hover:-translate-y-0.5 hover:bg-[#2EB872] md:col-span-2"
            >
              {brand.primaryCta}
            </button>
            <p class="text-center text-xs text-slate-500 md:col-span-2">
              Prefer to talk now? Call <a class="font-bold text-[#0B1F33]" href={brand.phoneHref}>{brand.phoneDisplay}</a>
            </p>
          </form>
        </div>
      </section>
    </main>

    <footer class="bg-[#07172A] pb-28 pt-12 text-white md:pb-12">
      <div class="section-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr_0.9fr]">
        <div>
          <img src={brand.logo} alt={brand.name} class="h-20 w-auto rounded-md bg-white p-2" width="240" height="220" loading="lazy" />
          <p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">{brand.tagline}</p>
          <div class="mt-6">
            <p class="font-bold text-white">Ready for a cleaner space?</p>
            <a class="mt-3 inline-flex min-h-11 items-center justify-center rounded-md bg-[#2E7D32] px-5 text-sm font-extrabold text-white transition hover:bg-[#2EB872]" href="#contact">
              {brand.primaryCta}
            </a>
          </div>
        </div>
        <div class="grid gap-4 text-sm text-slate-200 sm:grid-cols-2">
          <p><span class="block font-bold text-white">Phone</span> <a href={brand.phoneHref}>{brand.phoneDisplay}</a></p>
          <p class="break-words"><span class="block font-bold text-white">Email</span> <a href={`mailto:${brand.email}`}>{brand.email}</a></p>
          <p class="break-words"><span class="block font-bold text-white">Instagram</span> <a href={brand.instagramHref}>{brand.instagram}</a></p>
          <p><span class="block font-bold text-white">Service Area</span> Massachusetts</p>
        </div>
        <nav class="grid gap-2 text-sm" aria-label="Footer navigation">
          {navItems.map((item) => <a class="text-slate-300 transition hover:text-white" href={item.href}>{item.label}</a>)}
          <span class="mt-4 text-xs font-bold uppercase tracking-[0.14em] text-[#2EB872]">Services</span>
          <a class="text-slate-300 transition hover:text-white" href="#services">Residential Cleaning</a>
          <a class="text-slate-300 transition hover:text-white" href="#services">Commercial Cleaning</a>
          <a class="text-slate-300 transition hover:text-white" href="#services">Move In / Move Out</a>
          <a class="text-slate-300 transition hover:text-white" href="#services">Post Construction</a>
        </nav>
      </div>
      <div class="section-shell mt-10 border-t border-white/10 pt-6 text-xs text-slate-400">
        &copy; 2026 ALL PRO Cleaning Services. Residential and commercial cleaning in Massachusetts.
      </div>
    </footer>

    <div class="fixed inset-x-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 grid grid-cols-2 gap-2 md:hidden">
      <a
        href={brand.phoneHref}
        class="flex min-h-14 items-center justify-center rounded-md bg-[#2E7D32] text-sm font-extrabold text-white shadow-2xl"
        aria-label={`Call ${brand.name} now`}
      >
        Call Now
      </a>
      <a
        href="#contact"
        class="flex min-h-14 items-center justify-center rounded-md bg-white text-sm font-extrabold text-[#0B1F33] shadow-2xl"
      >
        Estimate
      </a>
    </div>
  </body>
</html>
