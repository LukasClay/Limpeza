---
import "../styles/global.css";

const services = [
  { icon: "sparkles", title: "Weekly" },
  { icon: "refresh", title: "Bi-weekly" },
  { icon: "calendar", title: "Monthly" },
  { icon: "key", title: "Move in/out" },
  { icon: "hammer", title: "Post Construction" },
  { icon: "building", title: "Commercial" },
] as const;

const iconPaths = {
  sparkles: [
    "M12 3l1.7 4.6L18 9.3l-4.3 1.7L12 16l-1.7-5L6 9.3l4.3-1.7L12 3z",
    "M5 14l.9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14z",
    "M19 14l.7 1.8L22 16.5l-2.3.7L19 19l-.7-1.8-2.3-.7 2.3-.7L19 14z",
  ],
  refresh: [
    "M21 12a9 9 0 0 1-15.4 6.4",
    "M3 12A9 9 0 0 1 18.4 5.6",
    "M18 2v4h-4",
    "M6 22v-4h4",
  ],
  calendar: [
    "M7 3v4",
    "M17 3v4",
    "M4 9h16",
    "M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z",
  ],
  key: [
    "M15 7a4 4 0 1 1 2.8 6.8L14 17.6V21h-4v-3H7v-4h3.4l3.8-3.8A4 4 0 0 1 15 7z",
    "M18 7h.01",
  ],
  hammer: [
    "M14 4l6 6",
    "M13 5l2-2 6 6-2 2",
    "M3 21l8-8",
    "M12 12l-2-2 3-3 4 4-3 3-2-2z",
  ],
  building: [
    "M4 21V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v16",
    "M17 9h2a2 2 0 0 1 2 2v10",
    "M8 7h1",
    "M12 7h1",
    "M8 11h1",
    "M12 11h1",
    "M8 15h1",
    "M12 15h1",
    "M3 21h19",
  ],
} as const;

const trustItems = ["Fully Insured", "Trusted", "Reliable", "Professional"];

const reviews = [
  {
    text: "The team was on time, detailed, and left the whole place feeling brand new.",
    name: "Maria S.",
  },
  {
    text: "Easy estimate, great communication, and a spotless office before opening.",
    name: "Daniel R.",
  },
];

const phoneDisplay = "(555) 123-4567";
const phoneHref = "tel:+15551234567";
const email = "hello@primeclean.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Premium residential and commercial cleaning services with fast estimates and reliable scheduling."
    />
    <title>PrimeClean | Residential & Commercial Cleaning</title>
  </head>
  <body class="antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
      <div class="section-shell flex h-20 items-center justify-between gap-5">
        <a href="#home" class="brand text-2xl font-bold text-[#071f36]" aria-label="PrimeClean home">
          PrimeClean
        </a>

        <nav class="hidden items-center gap-8 text-sm font-semibold text-slate-700 md:flex" aria-label="Primary navigation">
          <a class="transition hover:text-[#168356]" href="#home">Home</a>
          <a class="transition hover:text-[#168356]" href="#services">Services</a>
          <a class="transition hover:text-[#168356]" href="#about">About</a>
          <a class="transition hover:text-[#168356]" href="#contact">Contact</a>
        </nav>

        <a
          href={phoneHref}
          class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#23b26d] px-4 text-sm font-bold text-white shadow-sm transition hover:bg-[#168356]"
        >
          CALL NOW
        </a>
      </div>
    </header>

    <main id="home" class="pt-20">
      <section class="bg-[#071f36] text-white">
        <div class="section-shell grid min-h-[calc(100svh-80px)] items-center gap-12 py-16 md:grid-cols-[1.02fr_0.98fr] md:py-20">
          <div class="max-w-2xl">
            <p class="mb-5 inline-flex rounded-md bg-white/10 px-3 py-2 text-sm font-semibold text-emerald-100 ring-1 ring-white/15">
              Residential & commercial cleaning
            </p>
            <h1 class="text-5xl font-bold leading-tight md:text-6xl">
              A cleaner space, without the stress.
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-200">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Reliable cleaning for homes,
              offices, move-outs, and post-construction spaces.
            </p>
            <div class="mt-9 flex flex-col gap-3 sm:flex-row">
              <a
                href={phoneHref}
                class="inline-flex min-h-12 items-center justify-center rounded-md bg-[#23b26d] px-6 text-base font-bold text-white transition hover:bg-[#168356]"
              >
                CALL NOW
              </a>
              <a
                href="#contact"
                class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/30 px-6 text-base font-bold text-white transition hover:bg-white hover:text-[#071f36]"
              >
                GET FREE ESTIMATE
              </a>
            </div>
          </div>

          <div class="relative">
            <img
              src="/hero-cleaning.png"
              alt="Spotless modern interior after a professional cleaning service"
              class="hero-shadow aspect-[4/3] w-full rounded-lg object-cover"
              loading="eager"
              width="1536"
              height="1024"
            />
            <div class="absolute bottom-4 left-4 rounded-md bg-white px-4 py-3 text-[#071f36] shadow-xl">
              <p class="text-sm font-bold">Same-week estimates</p>
              <p class="text-xs text-slate-600">Homes, offices, and turnovers</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Trust badges" class="border-b border-slate-200 bg-white">
        <div class="section-shell grid grid-cols-2 gap-4 py-6 md:grid-cols-4">
          {
            trustItems.map((item) => (
              <div class="flex items-center gap-3 text-sm font-bold text-[#071f36]">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-[#168356]">
                  ✓
                </span>
                <span>{item}</span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="services" class="bg-white py-20 md:py-24">
        <div class="section-shell">
          <div class="max-w-2xl">
            <p class="text-sm font-bold uppercase text-[#168356]">Services</p>
            <h2 class="mt-3 text-4xl font-bold text-[#071f36] md:text-5xl">Simple, reliable cleaning plans.</h2>
          </div>

          <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              services.map((service) => (
                <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                  <div class="mb-5 flex size-12 items-center justify-center rounded-md bg-[#071f36] text-white">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      class="size-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      {iconPaths[service.icon].map((path) => <path d={path} />)}
                    </svg>
                  </div>
                  <h3 class="text-2xl font-bold text-[#071f36]">{service.title}</h3>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-[#f5f8fb] py-16">
        <div class="section-shell">
          <p class="mx-auto max-w-4xl text-center text-4xl font-bold leading-tight text-[#071f36] md:text-5xl">
            Walk into a space that already feels taken care of.
          </p>
        </div>
      </section>

      <section id="contact" class="bg-[#071f36] py-20 text-white md:py-24">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.82fr_1.18fr]">
          <div>
            <p class="text-sm font-bold uppercase text-emerald-200">Get started</p>
            <h2 class="mt-3 text-4xl font-bold md:text-5xl">Get your free estimate today.</h2>
            <p class="mt-5 text-lg leading-8 text-slate-200">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Tell us what you need and
              we will follow up quickly.
            </p>
            <a
              href={phoneHref}
              class="mt-8 inline-flex min-h-12 items-center justify-center rounded-md bg-[#23b26d] px-6 text-base font-bold text-white transition hover:bg-[#168356]"
            >
              CALL NOW
            </a>
          </div>

          <form class="grid gap-4 rounded-lg bg-white p-5 text-[#102132] shadow-2xl md:grid-cols-2 md:p-8">
            <label class="grid gap-2 text-sm font-bold">
              Name
              <input class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" type="text" name="name" autocomplete="name" />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Phone
              <input class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" type="tel" name="phone" autocomplete="tel" />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Email
              <input class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" type="email" name="email" autocomplete="email" />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Service
              <select class="min-h-12 rounded-md border border-slate-300 px-4 font-normal" name="service">
                <option>Weekly</option>
                <option>Bi-weekly</option>
                <option>Monthly</option>
                <option>Move in/out</option>
                <option>Post Construction</option>
                <option>Commercial</option>
              </select>
            </label>
            <label class="grid gap-2 text-sm font-bold md:col-span-2">
              Message
              <textarea class="min-h-32 rounded-md border border-slate-300 px-4 py-3 font-normal" name="message"></textarea>
            </label>
            <button
              type="submit"
              class="min-h-12 rounded-md bg-[#23b26d] px-6 text-base font-bold text-white transition hover:bg-[#168356] md:col-span-2"
            >
              GET FREE ESTIMATE
            </button>
          </form>
        </div>
      </section>

      <section id="about" class="bg-white py-20 md:py-24">
        <div class="section-shell grid gap-8 md:grid-cols-[0.72fr_1fr] md:items-center">
          <p class="text-sm font-bold uppercase text-[#168356]">About</p>
          <div>
            <h2 class="text-4xl font-bold text-[#071f36] md:text-5xl">Clean work. Clear communication.</h2>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Our team focuses on reliable
              schedules, careful details, and spaces that feel ready to use.
            </p>
          </div>
        </div>
      </section>

      <section class="bg-[#f5f8fb] py-20 md:py-24" aria-labelledby="reviews-title">
        <div class="section-shell">
          <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <div>
              <p class="text-sm font-bold uppercase text-[#168356]">Reviews</p>
              <h2 id="reviews-title" class="mt-3 text-4xl font-bold text-[#071f36] md:text-5xl">
                What clients say.
              </h2>
            </div>
            <a
              href="#contact"
              class="inline-flex min-h-12 items-center justify-center rounded-md bg-[#071f36] px-6 text-base font-bold text-white transition hover:bg-[#103452]"
            >
              GET FREE ESTIMATE
            </a>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-2">
            {
              reviews.map((review) => (
                <article class="rounded-lg bg-white p-6 shadow-sm ring-1 ring-slate-200">
                  <p class="text-lg leading-8 text-slate-700">&ldquo;{review.text}&rdquo;</p>
                  <p class="mt-5 font-bold text-[#071f36]">{review.name}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-[#071f36] pb-24 pt-12 text-white md:pb-12">
      <div class="section-shell grid gap-8 md:grid-cols-[1fr_1.5fr]">
        <div>
          <p class="brand text-3xl font-bold">PrimeClean</p>
          <p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">
            Residential and commercial cleaning for busy homes, offices, and fresh starts.
          </p>
        </div>
        <div class="grid gap-4 text-sm text-slate-200 sm:grid-cols-2">
          <p><span class="font-bold text-white">Phone:</span> {phoneDisplay}</p>
          <p><span class="font-bold text-white">Email:</span> {email}</p>
          <p><span class="font-bold text-white">Instagram:</span> @primeclean</p>
          <p><span class="font-bold text-white">Service area:</span> Your city and nearby areas</p>
        </div>
      </div>
    </footer>

    <a
      href={phoneHref}
      class="fixed inset-x-4 bottom-4 z-50 flex min-h-14 items-center justify-center rounded-md bg-[#23b26d] text-base font-bold text-white shadow-2xl md:hidden"
      aria-label="Call PrimeClean now"
    >
      CALL NOW
    </a>
  </body>
</html>
