---
import "../styles/global.css";

const brand = {
  name: "ALL PRO Cleaning Services",
  shortName: "ALL PRO",
  tagline: "Not just clean. ALL PRO clean.",
  statement: "Clean spaces. Better living.",
  phoneDisplay: "(617) 955-4047",
  phoneHref: "tel:+16179554047",
  email: "allprocleaninginc1@gmail.com",
  instagram: "@allprocleaninginc1",
  instagramHref: "https://www.instagram.com/allprocleaninginc1",
  area: "Serving Massachusetts",
  logo: "/brand/logo-primary.png",
  heroImage: "/hero-cleaning.png",
};

const navItems = [
  { label: "Services", href: "#services" },
  { label: "About", href: "#about" },
  { label: "Reviews", href: "#reviews" },
  { label: "Contact", href: "#contact" },
] as const;

const services = [
  { icon: "sparkles", title: "Weekly", label: "Weekly Cleaning", text: "Consistent care for busy homes." },
  { icon: "refresh", title: "Bi-weekly", label: "Bi-weekly Cleaning", text: "A reliable rhythm that keeps up." },
  { icon: "calendar", title: "Monthly", label: "Monthly Cleaning", text: "Deep resets on a simple schedule." },
  { icon: "key", title: "Move In", label: "Move In", text: "Start fresh before the first box opens." },
  { icon: "home", title: "Move Out", label: "Move Out", text: "Leave the space ready for its next use." },
  { icon: "building", title: "Post Construction", label: "Post Construction", text: "Detailed cleanup after the dust settles." },
] as const;

const trustBar = [
  { icon: "shield", title: "Fully Insured", text: "Professional coverage" },
  { icon: "estimate", title: "Free Estimates", text: "Clear next step" },
  { icon: "home", title: "Residential", text: "Homes and apartments" },
  { icon: "building", title: "Commercial", text: "Offices and businesses" },
  { icon: "map", title: "Massachusetts", text: "Local service area" },
] as const;

const aboutPoints = [
  { icon: "shield", title: "Insured" },
  { icon: "clock", title: "Reliable" },
  { icon: "sparkles", title: "Detail-Oriented" },
] as const;

const processItems = [
  "Quick request",
  "Clear estimate",
  "Professional cleaning",
  "Fresh, ready space",
] as const;

const reviews = [
  {
    text: "They were professional, careful, and the house looked spotless.",
    name: "M. Santos",
    location: "Framingham, MA",
  },
  {
    text: "Clear communication, fair estimate, and reliable service for our space.",
    name: "D. Riley",
    location: "Worcester, MA",
  },
  {
    text: "Everything felt organized from the first call to the final walkthrough.",
    name: "A. Miller",
    location: "Boston, MA",
  },
] as const;

const iconPaths = {
  sparkles: [
    "M12 3l1.7 4.6L18 9.3l-4.3 1.7L12 16l-1.7-5L6 9.3l4.3-1.7L12 3z",
    "M5 14l.9 2.1L8 17l-2.1.9L5 20l-.9-2.1L2 17l2.1-.9L5 14z",
    "M19 14l.7 1.8L22 16.5l-2.3.7L19 19l-.7-1.8-2.3-.7 2.3-.7L19 14z",
  ],
  refresh: ["M21 12a9 9 0 0 1-15.4 6.4", "M3 12A9 9 0 0 1 18.4 5.6", "M18 2v4h-4", "M6 22v-4h4"],
  calendar: ["M7 3v4", "M17 3v4", "M4 9h16", "M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"],
  key: ["M15 7a4 4 0 1 1 2.8 6.8L14 17.6V21h-4v-3H7v-4h3.4l3.8-3.8A4 4 0 0 1 15 7z", "M18 7h.01"],
  home: ["M3 11l9-8 9 8", "M5 10v10h14V10", "M9 20v-6h6v6"],
  building: ["M4 21V5a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v16", "M17 9h2a2 2 0 0 1 2 2v10", "M8 7h1", "M12 7h1", "M8 11h1", "M12 11h1", "M8 15h1", "M12 15h1", "M3 21h19"],
  shield: ["M12 3l7 3v5c0 5-3 8.5-7 10-4-1.5-7-5-7-10V6l7-3z", "M9 12l2 2 4-5"],
  estimate: ["M7 4h10a2 2 0 0 1 2 2v14l-3-2-3 2-3-2-3 2V6a2 2 0 0 1 2-2z", "M9 9h6", "M9 13h6"],
  map: ["M9 18l-6 3V6l6-3 6 3 6-3v15l-6 3-6-3z", "M9 3v15", "M15 6v15"],
  clock: ["M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z", "M12 7v5l3 2"],
  phone: ["M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7l.5 3a2 2 0 0 1-.6 1.8L7.7 9.8a16 16 0 0 0 6.5 6.5l1.3-1.3a2 2 0 0 1 1.8-.6l3 .5a2 2 0 0 1 1.7 2z"],
  users: ["M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2", "M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z", "M22 21v-2a4 4 0 0 0-3-3.9", "M16 3.1a4 4 0 0 1 0 7.8"],
  star: ["M12 3l2.7 5.5 6.1.9-4.4 4.3 1 6.1L12 16.9 6.6 19.8l1-6.1-4.4-4.3 6.1-.9L12 3z"],
} as const;

const starArray = [1, 2, 3, 4, 5] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="ALL PRO Cleaning Services offers residential and commercial cleaning in Massachusetts with free estimates and fully insured service."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Montserrat:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <title>{brand.name} | Residential & Commercial Cleaning</title>
  </head>
  <body class="antialiased">
    <header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/95 shadow-[0_1px_18px_rgba(15,23,42,0.06)] backdrop-blur-xl">
      <div class="section-shell flex h-[72px] items-center justify-between gap-4">
        <a href="#home" class="flex items-center gap-3" aria-label={`${brand.name} home`}>
          <img src={brand.logo} alt={brand.name} class="h-11 w-auto mix-blend-multiply md:h-12" width="240" height="220" />
        </a>

        <nav class="hidden items-center gap-8 text-sm font-bold text-[#1e2f5a] lg:flex" aria-label="Primary navigation">
          {navItems.map((item) => <a class="transition hover:text-[#4f913f]" href={item.href}>{item.label}</a>)}
        </nav>

        <div class="hidden items-center gap-3 md:flex">
          <a class="text-sm font-extrabold text-[#1e2f5a] transition hover:text-[#4f913f]" href={brand.phoneHref}>
            {brand.phoneDisplay}
          </a>
          <a
            href="#contact"
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-[#6baf5b] px-5 text-sm font-extrabold text-white shadow-[0_10px_24px_rgba(79,145,63,0.24)] transition hover:-translate-y-0.5 hover:bg-[#4f913f]"
          >
            Get Free Estimate
          </a>
        </div>

        <details class="mobile-menu relative md:hidden">
          <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-md border border-slate-200 text-[#1e2f5a]">
            <span class="sr-only">Open menu</span>
            <span class="block h-0.5 w-5 bg-current before:relative before:-top-1.5 before:block before:h-0.5 before:bg-current after:relative after:top-1 after:block after:h-0.5 after:bg-current"></span>
          </summary>
          <div class="absolute right-0 top-14 w-[min(84vw,320px)] rounded-lg border border-slate-200 bg-white p-3 shadow-2xl">
            {navItems.map((item) => <a class="block rounded-md px-4 py-3 text-sm font-bold text-[#1e2f5a] hover:bg-[#f6f8f6]" href={item.href}>{item.label}</a>)}
            <a class="mt-2 flex min-h-12 items-center justify-center rounded-md bg-[#6baf5b] px-4 text-sm font-extrabold text-white" href="#contact">
              Get Free Estimate
            </a>
          </div>
        </details>
      </div>
    </header>

    <main id="home" class="pt-[72px]">
      <section class="relative overflow-hidden bg-[#f8faf8]">
        <div class="absolute inset-x-0 top-0 h-[64%] bg-[#1e2f5a]"></div>
        <div class="section-shell relative grid min-h-[calc(100svh-72px)] items-center gap-10 py-10 md:grid-cols-[0.92fr_1.08fr] md:py-16">
          <div class="reveal max-w-2xl text-white">
            <p class="inline-flex rounded-md border border-white/15 bg-white/10 px-3 py-2 text-xs font-extrabold uppercase tracking-[0.16em] text-[#d8ead3]">
              Residential & Commercial Cleaning
            </p>
            <h1 class="mt-6 text-5xl font-bold leading-[1.02] md:text-6xl lg:text-7xl">
              Cleaning that makes your space feel professionally cared for.
            </h1>
            <p class="mt-6 max-w-xl text-lg leading-8 text-slate-100 md:text-xl">
              A polished, reliable cleaning experience for homes, offices, move-ins, move-outs, and
              post-construction spaces.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href="#contact"
                class="inline-flex min-h-[52px] items-center justify-center rounded-md bg-[#6baf5b] px-7 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(79,145,63,0.28)] transition hover:-translate-y-0.5 hover:bg-[#4f913f]"
              >
                Get Free Estimate
              </a>
              <a
                href={brand.phoneHref}
                class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-white/25 bg-white/10 px-7 text-base font-extrabold text-white transition hover:bg-white hover:text-[#1e2f5a]"
              >
                Call {brand.phoneDisplay}
              </a>
            </div>

            <div class="mt-8 grid gap-3 text-sm font-bold text-slate-100 sm:grid-cols-3">
              {["Fully Insured", "Free Estimates", "Serving Massachusetts"].map((item) => (
                <div class="flex items-center gap-2 rounded-md border border-white/[0.12] bg-white/[0.08] px-3 py-3">
                  <span class="flex size-6 items-center justify-center rounded-full bg-[#6baf5b]/20 text-[#d8ead3]">
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      {iconPaths.shield.map((path) => <path d={path} />)}
                    </svg>
                  </span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="reveal relative pb-9 md:pb-0">
            <div class="relative overflow-hidden rounded-lg bg-[#0f1f3d] shadow-[0_34px_90px_rgba(2,8,23,0.32)] ring-1 ring-white/10">
              <img
                src={brand.heroImage}
                alt="Bright clean interior after professional cleaning service"
                class="aspect-[4/3] w-full object-cover opacity-95"
                width="1536"
                height="1024"
                loading="eager"
                fetchpriority="high"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0f1f3d]/72 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 grid gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
                <div class="rounded-md bg-white/95 p-4 text-[#1e2f5a] shadow-xl">
                  <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-[#4f913f]">ALL PRO Standard</p>
                  <p class="mt-1 text-xl font-bold">Clean spaces. Better living.</p>
                </div>
                <div class="rounded-md bg-[#1e2f5a] p-4 text-white shadow-xl ring-1 ring-white/10">
                  <p class="text-3xl font-extrabold">5</p>
                  <p class="text-xs font-bold uppercase tracking-[0.14em] text-[#d8ead3]">Core services</p>
                </div>
              </div>
            </div>

            <div class="absolute -right-2 top-6 hidden w-56 rounded-lg bg-white p-4 text-[#1e2f5a] shadow-2xl ring-1 ring-slate-200 md:block">
              <div class="flex items-center gap-3">
                <span class="flex size-10 items-center justify-center rounded-full bg-[#ecf2ed] text-[#4f913f]">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    {iconPaths.shield.map((path) => <path d={path} />)}
                  </svg>
                </span>
                <div>
                  <p class="font-extrabold">Fully Insured</p>
                  <p class="text-xs text-slate-500">Built for trust</p>
                </div>
              </div>
            </div>

            <div class="absolute -bottom-1 left-5 right-5 rounded-lg bg-white p-4 shadow-2xl ring-1 ring-slate-200 md:-bottom-8 md:left-8 md:right-auto md:w-72">
              <p class="text-xs font-extrabold uppercase tracking-[0.16em] text-[#4f913f]">Fast next step</p>
              <p class="mt-1 text-lg font-bold text-[#1e2f5a]">Free estimate by phone or form</p>
            </div>
          </div>
        </div>
      </section>

      <section aria-label="Trust badges" class="border-y border-slate-200 bg-white">
        <div class="section-shell grid gap-px overflow-hidden py-5 sm:grid-cols-2 lg:grid-cols-5">
          {
            trustBar.map((item) => (
              <div class="flex items-start gap-3 bg-white px-1 py-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-md bg-[#f1f5f1] text-[#4f913f]">
                  <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                    {iconPaths[item.icon].map((path) => <path d={path} />)}
                  </svg>
                </span>
                <span>
                  <strong class="block text-sm text-[#1e2f5a]">{item.title}</strong>
                  <span class="text-sm text-slate-500">{item.text}</span>
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <section id="services" class="bg-[#f6f8f6] py-20 md:py-24">
        <div class="section-shell">
          <div class="grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:items-end">
            <div>
              <p class="eyebrow">Our Services</p>
              <h2 class="mt-3 text-4xl font-bold text-[#1e2f5a] md:text-5xl">A polished clean for every kind of space.</h2>
            </div>
            <p class="max-w-2xl text-lg leading-8 text-slate-600 md:justify-self-end">
              Flexible cleaning options with a consistent, professional standard from first contact
              to final walkthrough.
            </p>
          </div>

          <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
              services.map((service) => (
                <article class="service-card reveal rounded-lg border border-slate-200 bg-white p-7 shadow-[0_10px_30px_rgba(15,31,61,0.05)] transition duration-300 hover:-translate-y-1 hover:border-[#cfdccf] hover:shadow-[0_18px_42px_rgba(15,31,61,0.09)]">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex size-12 items-center justify-center rounded-md bg-[#1e2f5a] text-white">
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        {iconPaths[service.icon].map((path) => <path d={path} />)}
                      </svg>
                    </div>
                    <span class="rounded-full bg-[#ecf2ed] px-3 py-1 text-xs font-extrabold uppercase tracking-[0.12em] text-[#4f913f]">
                      ALL PRO
                    </span>
                  </div>
                  <h3 class="mt-7 text-2xl font-bold text-[#1e2f5a]">{service.title}</h3>
                  <p class="mt-3 leading-7 text-slate-600">{service.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section class="bg-[#1e2f5a] py-16 text-white">
        <div class="section-shell grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
          <p class="max-w-3xl text-4xl font-bold leading-tight md:text-5xl">
            {brand.statement}
          </p>
          <a
            href="#contact"
            class="inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 text-base font-extrabold text-[#1e2f5a] transition hover:-translate-y-0.5 hover:bg-[#ecf2ed]"
          >
            Get Free Estimate
          </a>
        </div>
      </section>

      <section id="about" class="bg-white py-20 md:py-24">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
          <div class="reveal relative">
            <img
              src={brand.heroImage}
              alt="Clean home interior representing professional residential cleaning"
              class="aspect-[4/3] w-full rounded-lg object-cover shadow-[0_24px_70px_rgba(15,31,61,0.16)]"
              width="1536"
              height="1024"
              loading="lazy"
            />
            <div class="absolute bottom-4 left-4 right-4 rounded-lg bg-white/95 p-5 shadow-xl ring-1 ring-slate-200 sm:right-auto sm:w-80">
              <p class="text-sm font-extrabold uppercase tracking-[0.14em] text-[#4f913f]">Premium accessible</p>
              <p class="mt-2 text-xl font-bold text-[#1e2f5a]">{brand.tagline}</p>
            </div>
          </div>

          <div class="reveal">
            <p class="eyebrow">About ALL PRO</p>
            <h2 class="mt-3 text-4xl font-bold leading-tight text-[#1e2f5a] md:text-5xl">
              Local service with the visual standard of an established company.
            </h2>
            <p class="mt-5 text-lg leading-8 text-slate-600">
              ALL PRO Cleaning Services is built around clear communication, careful details, and
              a dependable process for both residential and commercial clients.
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-3">
              {
                aboutPoints.map((point) => (
                  <div class="rounded-lg border border-slate-200 bg-[#f8faf8] p-4">
                    <div class="flex size-10 items-center justify-center rounded-md bg-white text-[#4f913f] shadow-sm">
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        {iconPaths[point.icon].map((path) => <path d={path} />)}
                      </svg>
                    </div>
                    <p class="mt-4 font-extrabold text-[#1e2f5a]">{point.title}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section id="reviews" class="bg-[#f6f8f6] py-20 md:py-24" aria-labelledby="reviews-title">
        <div class="section-shell">
          <div class="max-w-3xl">
            <p class="eyebrow">Testimonials</p>
            <h2 id="reviews-title" class="mt-3 text-4xl font-bold text-[#1e2f5a] md:text-5xl">
              Proof that feels organized, calm, and reliable.
            </h2>
          </div>

          <div class="mt-12 grid gap-4 lg:grid-cols-3">
            {
              reviews.map((review) => (
                <article class="reveal rounded-lg border border-slate-200 bg-white p-7 shadow-[0_10px_30px_rgba(15,31,61,0.05)]">
                  <div class="flex gap-1 text-[#6baf5b]" aria-label="Five star review">
                    {starArray.map(() => (
                      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-4" fill="currentColor">
                        {iconPaths.star.map((path) => <path d={path} />)}
                      </svg>
                    ))}
                  </div>
                  <p class="mt-5 text-lg leading-8 text-slate-700">&ldquo;{review.text}&rdquo;</p>
                  <div class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
                    <span class="flex size-11 items-center justify-center rounded-full bg-[#1e2f5a] text-sm font-extrabold text-white">
                      {review.name.slice(0, 1)}
                    </span>
                    <span>
                      <strong class="block text-[#1e2f5a]">{review.name}</strong>
                      <span class="text-sm text-slate-500">{review.location}</span>
                    </span>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="contact" class="bg-[#1e2f5a] py-20 text-white md:py-24">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
          <div class="reveal">
            <p class="text-sm font-extrabold uppercase tracking-[0.16em] text-[#d8ead3]">Get started</p>
            <h2 class="mt-3 text-4xl font-bold leading-tight md:text-5xl">Request your free estimate.</h2>
            <p class="mt-5 text-lg leading-8 text-slate-100">
              A focused final step for visitors who are ready to compare options, schedule a
              cleaning, or simply ask what the first visit would look like.
            </p>
            <div class="mt-8 grid gap-3">
              {
                processItems.map((item, index) => (
                  <div class="flex items-center gap-3 rounded-md border border-white/10 bg-white/[0.08] px-4 py-3">
                    <span class="flex size-8 items-center justify-center rounded-full bg-[#6baf5b] text-sm font-extrabold text-white">{index + 1}</span>
                    <span class="font-bold">{item}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <form class="reveal grid gap-4 rounded-lg bg-white p-5 text-[#102132] shadow-[0_34px_90px_rgba(2,8,23,0.32)] md:grid-cols-2 md:p-8" aria-label="Free estimate form">
            <label class="grid gap-2 text-sm font-bold">
              Name
              <input class="field" type="text" name="name" autocomplete="name" required />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Phone
              <input class="field" type="tel" name="phone" autocomplete="tel" required />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Email
              <input class="field" type="email" name="email" autocomplete="email" required />
            </label>
            <label class="grid gap-2 text-sm font-bold">
              Service
              <select class="field" name="service">
                {services.map((service) => <option>{service.label}</option>)}
              </select>
            </label>
            <label class="grid gap-2 text-sm font-bold md:col-span-2">
              Message
              <textarea class="field min-h-32 py-3" name="message"></textarea>
            </label>
            <button
              type="submit"
              class="min-h-[52px] rounded-md bg-[#6baf5b] px-6 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(79,145,63,0.25)] transition hover:-translate-y-0.5 hover:bg-[#4f913f] md:col-span-2"
            >
              Get Free Estimate
            </button>
            <p class="text-center text-xs text-slate-500 md:col-span-2">
              Or call <a class="font-bold text-[#1e2f5a]" href={brand.phoneHref}>{brand.phoneDisplay}</a>
            </p>
          </form>
        </div>
      </section>
    </main>

    <footer class="bg-[#0f1f3d] pb-24 pt-12 text-white md:pb-12">
      <div class="section-shell grid gap-10 lg:grid-cols-[0.85fr_1.15fr_0.9fr]">
        <div>
          <img src={brand.logo} alt={brand.name} class="h-20 w-auto rounded-md bg-white p-2" width="240" height="220" loading="lazy" />
          <p class="mt-4 max-w-sm text-sm leading-6 text-slate-300">{brand.tagline}</p>
        </div>
        <div class="grid gap-4 text-sm text-slate-200 sm:grid-cols-2">
          <p><span class="block font-bold text-white">Phone</span> {brand.phoneDisplay}</p>
          <p><span class="block font-bold text-white">Email</span> {brand.email}</p>
          <p><span class="block font-bold text-white">Instagram</span> {brand.instagram}</p>
          <p><span class="block font-bold text-white">Service Area</span> Massachusetts</p>
        </div>
        <nav class="grid gap-2 text-sm" aria-label="Footer navigation">
          {navItems.map((item) => <a class="text-slate-300 transition hover:text-white" href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </footer>

    <a
      href={brand.phoneHref}
      class="fixed inset-x-4 bottom-4 z-50 flex min-h-14 items-center justify-center rounded-md bg-[#6baf5b] text-base font-extrabold text-white shadow-2xl md:hidden"
      aria-label={`Call ${brand.name} now`}
    >
      Call Now
    </a>
  </body>
</html>
