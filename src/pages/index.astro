---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import TrustBar from "../components/sections/TrustBar.astro";
import Services from "../components/sections/Services.astro";
import Statement from "../components/sections/Statement.astro";
import About from "../components/sections/About.astro";
import WhyUs from "../components/sections/WhyUs.astro";
import ServiceArea from "../components/sections/ServiceArea.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Faq from "../components/sections/Faq.astro";
import Contact from "../components/sections/Contact.astro";
import CtaFinal from "../components/sections/CtaFinal.astro";
import MobileCTA from "../components/ui/MobileCTA.astro";
import { brand, SITE_URL } from "../data/brand";
import { faqItems, services } from "../data/site";

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "HouseCleaningService"],
  name: brand.name,
  telephone: brand.phoneDisplay,
  email: brand.email,
  url: SITE_URL,
  logo: `${SITE_URL}${brand.logo}`,
  image: `${SITE_URL}${brand.heroImage}`,
  sameAs: [brand.instagramHref, `https://wa.me/${brand.whatsappNumber}`],
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Massachusetts",
  },
  serviceType: [
    "Residential Cleaning",
    "Commercial Cleaning",
    "Move In Cleaning",
    "Move Out Cleaning",
    "Post Construction Cleaning",
  ],
  description:
    "Professional residential and commercial cleaning services in Massachusetts. Fully insured, reliable, and available for weekly, bi-weekly, monthly, move-in, move-out, and post-construction cleaning.",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const serviceSchemas = services.map((service) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: service.title,
  description: service.text,
  provider: {
    "@type": "LocalBusiness",
    name: brand.name,
    telephone: brand.phoneDisplay,
    url: SITE_URL,
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Massachusetts",
  },
}));

const jsonLdGraph = {
  "@context": "https://schema.org",
  "@graph": [localBusinessSchema, faqSchema, ...serviceSchemas],
};
---

<BaseLayout jsonLd={jsonLdGraph}>
  <Header />
  <main id="main" class="pt-16 md:pt-[72px]">
    <Hero />
    <TrustBar />
    <Services />
    <Statement />
    <About />
    <WhyUs />
    <ServiceArea />
    <HowItWorks />
    <Faq />
    <Contact />
    <CtaFinal />
  </main>
  <Footer />
  <MobileCTA />
</BaseLayout>
