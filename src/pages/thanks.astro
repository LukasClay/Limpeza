---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileCTA from "../components/ui/MobileCTA.astro";
import Icon from "../components/ui/Icon.astro";
import { brand } from "../data/brand";
import { whatsappDefaultUrl } from "../lib/whatsapp";
---

<BaseLayout
  title="Thanks — your request was received | ALL PRO Cleaning Services"
  description="We received your estimate request. Continue the conversation on WhatsApp for the fastest reply."
  noindex
>
  <Header />
  <main class="bg-mist pt-16 md:pt-[72px]">
    <div class="section-shell flex min-h-[calc(100svh-72px)] items-center py-16">
      <div class="mx-auto max-w-2xl text-center">
        <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-green text-white">
          <Icon name="check" class="size-8" strokeWidth={2.5} />
        </div>
        <p class="mt-6 text-sm font-extrabold uppercase tracking-[0.16em] text-green-dark">Request received</p>
        <h1 class="mt-3 text-3xl font-bold text-navy sm:text-4xl md:text-5xl">
          Thanks — we got your request.
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-base leading-7 text-muted sm:text-lg">
          For the fastest reply, continue the conversation on WhatsApp. We will also send a
          confirmation to the email you provided.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={whatsappDefaultUrl}
            target="_blank"
            rel="noopener"
            class="hover-lift inline-flex min-h-[52px] items-center justify-center gap-2 rounded-md bg-whatsapp px-6 text-base font-extrabold text-white shadow-[0_18px_38px_rgba(37,211,102,0.32)] transition hover:-translate-y-0.5 hover:bg-whatsapp-dark"
          >
            <Icon name="whatsapp" class="size-5" strokeWidth={2} />
            Continue on WhatsApp
          </a>
          <a
            href={brand.phoneHref}
            class="inline-flex min-h-[52px] items-center justify-center rounded-md border border-slate-300 bg-white px-6 text-base font-extrabold text-navy transition hover:border-navy"
          >
            Call {brand.phoneDisplay}
          </a>
        </div>

        <p class="mt-8 text-sm text-muted">
          <a class="font-bold text-navy hover:underline" href="/">Back to home</a>
        </p>
      </div>
    </div>
  </main>
  <Footer />
  <MobileCTA />
</BaseLayout>
